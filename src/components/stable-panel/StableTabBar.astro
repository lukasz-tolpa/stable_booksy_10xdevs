---
import { BarChart3, CalendarDays, ClipboardList, Hourglass, LayoutDashboard, Users } from "lucide-react";
import { HorseHead } from "@/components/ui/HorseHead";
import { currentSection, stableTabBarSections } from "@/lib/auth/roles";
import { loadPendingCount } from "@/lib/bookings/pending-count";
import { navCounter } from "@/lib/bookings/waiting";

// Dolny pasek sekcji ośrodka na telefonie (spec #83): panel, Grafik, Zapisy, Zapisy do przyjęcia
// (spec 122), Konie, Instruktorzy i Statystyki pod ręką na każdej stronie ośrodka, bez przewijania do
// bocznej kolumny panelu. Tylko
// właściciel i tylko w przestrzeni ośrodka (na stronie głównej paska nie ma) — decyduje
// @/lib/auth/roles, nie strona. Od 1000 px pasek znika: panel ma wtedy boczną kolumnę obok treści.
// „Zapisy do przyjęcia” mają licznik czekających (#128) — plakietka na ikonie, pełna liczba w podpisie.
const sections = stableTabBarSections(Astro.locals.instructorStanding, Astro.url.pathname);
const current = currentSection(Astro.url.pathname, sections);
const pendingCount = sections.some((section) => section.counter === "pendingBookings")
  ? await loadPendingCount(Astro)
  : null;
// Ikony w kolejności `stableSections`; konie mają własną głowę konia (lucide nie ma nic końskiego).
const ICONS = [LayoutDashboard, CalendarDays, ClipboardList, Hourglass, HorseHead, Users, BarChart3];
---

{
  sections.length > 0 && (
    <nav class="tab-bar" aria-label="Sekcje ośrodka">
      <ul>
        {sections.map((section, index) => {
          const Icon = ICONS[index];
          const counter = section.counter === "pendingBookings" ? navCounter(section.label, pendingCount) : null;
          return (
            <li>
              <a
                href={section.href}
                aria-current={section.href === current ? "page" : undefined}
                aria-label={counter?.label ?? (section.shortLabel ? section.label : undefined)}
              >
                <span class="icon">
                  <Icon className="size-5" />
                  {counter && (
                    <span class="counter mono-nums" aria-hidden="true">
                      {counter.text}
                    </span>
                  )}
                </span>
                <span class="label">{section.shortLabel ?? section.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

<style>
  .tab-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--glass);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-top: 1px solid var(--border);
  }
  ul {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 600px;
    /* Siedem pozycji (#124) w równych kolumnach nie mieści „Instruktorzy” przy 390 px: kolumny dzielą
       szerokość według długości podpisu (wolne miejsce po równo), więc całe podpisy mieszczą się od 320 px. */
    display: flex;
  }
  li {
    flex: 1 1 auto;
    min-width: 0;
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 56px;
    padding: 6px 0;
    border-radius: 12px;
    font-size: 10px;
    letter-spacing: -0.01em;
    font-weight: 600;
    color: var(--muted);
    transition: color 0.15s;
  }
  .label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a:hover,
  a[aria-current="page"] {
    color: var(--primary-strong);
  }
  .icon {
    position: relative;
    display: inline-flex;
    padding: 2px 10px;
    border-radius: 999px;
    transition: background 0.15s;
  }
  a[aria-current="page"] .icon {
    background: var(--primary-soft);
  }
  .counter {
    position: absolute;
    top: -4px;
    right: -2px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--warn-ink);
    color: var(--surface);
    font-size: 10.5px;
    font-weight: 700;
    line-height: 17px;
    text-align: center;
  }
  a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
  }
  /* Treść nie chowa się pod paskiem: ciało strony dostaje dolny odstęp na jego wysokość. */
  :global(body:has(.tab-bar)) {
    padding-bottom: calc(57px + env(safe-area-inset-bottom));
  }
  @media (width >= 1000px) {
    .tab-bar {
      display: none;
    }
    :global(body:has(.tab-bar)) {
      padding-bottom: 0;
    }
  }
</style>
