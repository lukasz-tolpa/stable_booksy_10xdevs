---
// Panel ośrodka — wejście do Podsumowania miesiąca w kolumnie głównej (spec #87: „na telefonie wejście
// z panelu”). Ten sam `SideLink` co w bocznej kolumnie (`composeMonthSummaryLink`). Tylko poniżej
// 1000 px — od 1000 px link jest w bocznej kolumnie, a dolny pasek `StableTabBar` go nie ma.
import { ArrowRight } from "lucide-react";
import Card from "@/components/ui/Card.astro";
import type { SideLink } from "@/lib/stable-panel/panel";

interface Props {
  link: SideLink;
}

const { link } = Astro.props;
---

<div class="entry">
  <Card padding={0}>
    <a href={link.href} class="entry__link">
      <span class="entry__text">
        <span class="entry__name">{link.name}</span>
        {link.fact && <span class="entry__fact mono-nums"> &middot; {link.fact}</span>}
      </span>
      <ArrowRight className="size-4 shrink-0" aria-hidden="true" />
    </a>
  </Card>
</div>

<style>
  .entry {
    margin-top: 20px;
  }
  @media (width >= 1000px) {
    .entry {
      display: none;
    }
  }
  .entry__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    padding: 12px 18px;
    border-radius: var(--r-lg);
    color: var(--fg);
  }
  .entry__link:hover .entry__name {
    color: var(--primary);
  }
  .entry__link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .entry__text {
    min-width: 0;
  }
  .entry__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
  }
  .entry__fact {
    font-size: 14px;
    color: var(--muted);
  }
</style>
