---
import { instructorTabs } from "@/lib/auth/roles";
import { loadPendingCount } from "@/lib/bookings/pending-count";
import { navCounter } from "@/lib/bookings/waiting";

// Zakładki przestrzeni instruktora: „Moje sloty” i „Podsumowanie miesiąca” (#90) u każdego instruktora
// z kontem, między nimi „Grafik” u instruktora z uprawnieniem do układania grafiku (#79). Pusta lista
// (właściciel, zdezaktywowany) — pasek się nie pokazuje; mapa stanów konta w @/lib/auth/roles decyduje, nie strona.
const tabs = instructorTabs(Astro.locals.instructorStanding);
const current = Astro.url.pathname.replace(/\/$/, "");
// Zakładka z licznikiem (#128: zapisy do przyjęcia swoich slotów) — jeden odczyt na żądanie.
const pendingCount = tabs.some((tab) => tab.counter === "pendingBookings") ? await loadPendingCount(Astro) : null;
---

{
  tabs.length > 0 && (
    <nav class="tabs" aria-label="Przestrzeń instruktora">
      {tabs.map((tab) => {
        const counter = tab.counter === "pendingBookings" ? navCounter(tab.label, pendingCount) : null;
        return (
          <a href={tab.href} aria-current={tab.href === current ? "page" : undefined} aria-label={counter?.label}>
            {tab.label}
            {counter && (
              <span class="counter mono-nums" aria-hidden="true">
                {counter.text}
              </span>
            )}
          </a>
        );
      })}
    </nav>
  )
}

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }
  .tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    transition:
      background 0.15s,
      color 0.15s;
  }
  .tabs a:hover {
    color: var(--primary-strong);
    background: var(--surface-2);
  }
  .tabs a[aria-current="page"] {
    color: var(--primary-strong);
    background: var(--primary-soft);
  }
  .counter {
    margin-left: 8px;
    min-width: 20px;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--warn-ink);
    color: var(--surface);
    font-size: 12px;
    font-weight: 700;
    text-align: center;
  }
  .tabs a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>
