---
// Banner z DESIGN.md §5: pełna szerokość kontenera, lewy pasek 3 px, miękkie tło.
// Wariant `error` jako jedyny dostaje role="alert" - reszta to role="status".
// Ta reguła jest starsza niż redesign i zostaje bez zmian.
type Variant = "info" | "success" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  .banner {
    padding: 12px 14px;
    font-size: 14.5px;
    border-left: 3px solid;
    border-radius: 0 var(--r) var(--r) 0;
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  .banner--info {
    background: var(--primary-soft);
    color: var(--primary-strong);
    border-left-color: var(--primary);
  }
  .banner--success {
    background: var(--success-soft);
    color: var(--success-ink);
    border-left-color: var(--success);
  }
  .banner--warning {
    background: var(--warn-soft);
    color: var(--warn-ink);
    border-left-color: var(--warn);
  }
  .banner--error {
    background: var(--danger-soft);
    color: var(--danger-ink);
    border-left-color: var(--danger);
  }
</style>
