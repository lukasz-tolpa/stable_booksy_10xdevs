---
// PROTOTYPE — wariant A „Kwota na górze, jazdy zwinięte”: układ jak lista „Rozliczenia” — w głównej
// kolumnie karta z „Do zapłaty”, wyliczeniem, PDF i kosztami; lista jazd w zwiniętej sekcji „Jazdy (N)”.
// Boczna kolumna: miesiąc i stawka jeźdźca. Throwaway.
import { Download } from "lucide-react";
import Banner from "@/components/Banner.astro";
import MonthNav from "@/components/month-summary/MonthNav.astro";
import RideList from "@/components/month-summary/RideList.astro";
import RiderCosts from "@/components/settlements/RiderCosts.astro";
import RiderRate from "@/components/settlements/RiderRate.astro";
import GhostButton from "@/components/ui/GhostButton.astro";
import type { VariantProps } from "./types";

type Props = VariantProps;
const { view, riderRate, riderKey, month, listHref, saved, error } = Astro.props;
const s = view.settlement;
---

<div class="grid">
  <div class="main">
    {saved && <Banner variant="success">Zapisano.</Banner>}
    {error && <Banner variant="error">{error}</Banner>}

    <section class="box due-box" aria-label="Do zapłaty">
      <p class="eyebrow">Do zapłaty · {s.monthLabel}</p>
      <p class="big">{s.dueText ?? "—"}</p>
      <p class="calc">{s.ridesLine}{s.rateSourceText && <span class="src">{s.rateSourceText}</span>}</p>
      {s.costs.length > 0 && <p class="calc">+ koszty dodatkowe {s.costsAmountText}</p>}
      {
        s.needsRate && (
          <p class="calc">
            <a href={listHref}>Ustaw stawkę ośrodka</a>&nbsp;— wtedy pojawią się kwoty.
          </p>
        )
      }
      {
        view.pdfHref && (
          <div class="pdf">
            <GhostButton href={view.pdfHref}>
              <Download className="size-4" />
              Pobierz PDF
            </GhostButton>
          </div>
        )
      }
    </section>

    <section class="box">
      <RiderCosts settlement={s} />
    </section>

    {
      s.emptyText ? (
        <p class="box muted">{s.emptyText}</p>
      ) : (
        <details class="box rides">
          <summary>
            Jazdy <span class="count">{s.rides}</span>
            <span class="muted">
              — {s.rideRows[0]?.date} … {s.rideRows.at(-1)?.date}
            </span>
          </summary>
          <RideList rides={s.rideRows} label={`Jazdy — ${s.name}`} />
        </details>
      )
    }
  </div>

  <aside class="side">
    <MonthNav nav={view.nav} stacked />
    {riderRate && <RiderRate rate={riderRate} riderKey={riderKey} month={month} />}
  </aside>
</div>

<style>
  .grid {
    display: grid;
    gap: 16px;
    margin-top: 18px;
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) 300px;
      align-items: start;
    }
  }
  .main,
  .side {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .box {
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .eyebrow {
    margin: 0;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .big {
    margin: 4px 0 0;
    font-size: 34px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .calc {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: center;
    margin: 6px 0 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .src {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 12.5px;
    font-weight: 600;
  }
  .pdf {
    margin-top: 12px;
  }
  .rides summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font-weight: 700;
  }
  .rides[open] summary {
    margin-bottom: 10px;
  }
  .count {
    padding: 0 8px;
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 13px;
  }
  .muted {
    color: var(--muted);
    font-weight: 400;
  }
  .side :global(section) {
    margin: 0;
  }
</style>
