---
// Pigułka roli z DESIGN.md §2: Ośrodek = `--primary-strong` na `--primary-soft`,
// Jeździec = `--accent-ink` na `--accent-soft`. To jedno z dwóch dopuszczonych
// wystąpień kasztanu na ekranie, więc nie dokładamy go nigdzie indziej bez potrzeby.
//
// Ikona jest częścią komponentu, nie slotem: w każdym prototypie pigułka roli ma
// ikonę, więc przekazywanie jej z zewnątrz tylko pozwalałoby się rozjechać.
// Ośrodek dostaje stajnię (`StableBarn`, maska z generatora), jeździec sylwetkę
// z lucide. `aria-hidden`, bo etykieta tekstowa niesie całe znaczenie.
import { StableBarn } from "@/components/ui/StableBarn";
import { ROLE_LABELS } from "@/lib/auth/constants";
import type { UserRole } from "@/types";

interface Props {
  role: UserRole;
  class?: string;
}

const { role, class: className } = Astro.props;
---

<span class:list={["pill", `pill--${role}`, className]}>
  {
    role === "stable" ? (
      <StableBarn className="size-3.5" />
    ) : (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
        <circle cx="12" cy="7" r="4" />
      </svg>
    )
  }
  {ROLE_LABELS[role]}
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.35;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .pill svg {
    width: 14px;
    height: 14px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pill--stable {
    background: var(--primary-soft);
    color: var(--primary-strong);
  }
  .pill--rider {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
</style>
