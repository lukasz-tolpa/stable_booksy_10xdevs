---
// Pigułka roli z DESIGN.md §2: Ośrodek = `--primary-strong` na `--primary-soft`,
// Jeździec = `--accent-ink` na `--accent-soft`. To jedno z dwóch dopuszczonych
// wystąpień kasztanu na ekranie, więc nie dokładamy go nigdzie indziej bez potrzeby.
//
// Ikona jest częścią komponentu, nie slotem: w każdym prototypie pigułka roli ma
// ikonę (budynek dla ośrodka, sylwetka dla jeźdźca), więc przekazywanie jej z
// zewnątrz tylko pozwalałoby się rozjechać. Ścieżki pochodzą z lucide, tak jak
// w prototypach; `aria-hidden`, bo etykieta tekstowa niesie całe znaczenie.
import { ROLE_LABELS } from "@/lib/auth/constants";
import type { UserRole } from "@/types";

interface Props {
  role: UserRole;
  class?: string;
}

const { role, class: className } = Astro.props;
---

<span class:list={["pill", `pill--${role}`, className]}>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    {
      role === "stable" ? (
        <>
          <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
          <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
          <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
          <path d="M10 6h4" />
          <path d="M10 10h4" />
          <path d="M10 14h4" />
          <path d="M10 18h4" />
        </>
      ) : (
        <>
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </>
      )
    }
  </svg>
  {ROLE_LABELS[role]}
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.35;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .pill svg {
    width: 14px;
    height: 14px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pill--stable {
    background: var(--primary-soft);
    color: var(--primary-strong);
  }
  .pill--rider {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
</style>
