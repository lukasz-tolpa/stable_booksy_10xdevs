---
import Card from "@/components/ui/Card.astro";

// Karta-komunikat na środku strony: opcjonalny znak, nagłówek `h1`, jedno zdanie
// w `--muted` i jedno wyjście dalej — link (`href`) albo przycisk formularza POST
// (`formAction`, np. wylogowanie). Potwierdzenie e-maila, strona 404, nieaktywne konto
// instruktora — szerokość i odstępy jak karta logowania (420 px, padding 28 px).
type Props = {
  heading: string;
  lead: string;
  linkText: string;
  /** Znak nad nagłówkiem (emoji). */
  emoji?: string;
} & ({ href: string; formAction?: never } | { formAction: string; href?: never });

const { heading, lead, href, formAction, linkText, emoji } = Astro.props;
---

<div class="container-narrow noticewrap">
  <Card class="w-full max-w-[420px]" padding={28}>
    <div class="notice">
      {emoji && <div class="emoji">{emoji}</div>}
      <h1>{heading}</h1>
      <p class="lead">{lead}</p>
      {
        formAction ? (
          <form method="POST" action={formAction}>
            <button type="submit">{linkText}</button>
          </form>
        ) : (
          <a href={href}>{linkText}</a>
        )
      }
    </div>
  </Card>
</div>

<style>
  .noticewrap {
    display: flex;
    justify-content: center;
    padding-block: 36px 56px;
  }
  .notice {
    text-align: center;
  }
  .emoji {
    font-size: 44px;
    line-height: 1;
    margin-bottom: 14px;
  }
  h1 {
    font-size: 26px;
    margin: 0 0 8px;
  }
  .lead {
    font-size: 14.5px;
    color: var(--muted);
    margin: 0 0 22px;
  }
  .notice a,
  .notice button {
    font-size: 14.5px;
    color: var(--primary);
    font-weight: 600;
  }
  .notice button {
    border: 0;
    padding: 0;
    background: none;
    font-family: var(--font-body);
    cursor: pointer;
  }
  .notice a:hover,
  .notice button:hover {
    color: var(--primary-strong);
    text-decoration: underline;
  }
  .notice a:focus-visible,
  .notice button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
    border-radius: 6px;
  }
</style>
