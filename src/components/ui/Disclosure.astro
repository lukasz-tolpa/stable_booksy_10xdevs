---
// Zwijana sekcja: natywne <details> (bez JavaScriptu), domyślnie zwinięte. Cały nagłówek (`summary`) to
// cel dotykowy min. 52 px z szewronem marki, który obraca się po rozwinięciu. Treść nagłówka i sekcji
// podaje wołający (slot `summary` i domyślny); obramowanie i tło daje opakowanie wołającego (np. `Card`).
// Używają go: pełna lista jazd w rozliczeniu jeźdźca (`AllRides`) i „Pozostali jeźdźcy ośrodka”
// (`OtherRiders`).
//
// KONTRAKT e2e: `summary` zawiera tylko treść slotu `summary` — szewron to pseudo-element bez tekstu.
---

<details class="disclosure">
  <summary><slot name="summary" /></summary>
  <slot />
</details>

<style>
  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    /* 44 px to minimalny cel dotykowy — cały nagłówek rozwija sekcję. */
    min-height: 52px;
    padding: 10px 18px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: "";
    flex: none;
    width: 7px;
    height: 7px;
    margin-right: 4px;
    border-right: 2px solid var(--primary);
    border-bottom: 2px solid var(--primary);
    transform: rotate(-45deg);
    transition: transform 0.15s;
  }
  /* `open` ustawia przeglądarka, nie szablon — stąd :global dla samego atrybutu. */
  :global(.disclosure[open]) > summary::before {
    transform: rotate(45deg);
  }
  summary:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: var(--r-lg);
  }
</style>
