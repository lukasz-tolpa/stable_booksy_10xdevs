---
import { MapPin } from "lucide-react";
import type { StableListItem } from "@/lib/stables/queries";

interface Props {
  stable: StableListItem;
}

const { stable } = Astro.props;
---

<article class="rounded-xl border border-white/10 bg-white/5 p-5 text-white">
  <h2 class="text-lg font-semibold">{stable.name}</h2>
  <p class="mt-1 flex items-center gap-1.5 text-sm text-blue-100/70">
    <MapPin className="size-3.5" />
    {stable.city}
  </p>
  {stable.description && <p class="mt-3 line-clamp-3 text-sm text-blue-100/60">{stable.description}</p>}
</article>
