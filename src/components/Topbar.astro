---
/* eslint-disable astro/no-unused-css-selector -- reguły na `[open]` są używane;
   atrybut dokłada przeglądarka po kliknięciu, więc nie ma go w statycznym markupie */
import Logo from "@/components/Logo.astro";
import PrototypeSwitcher from "@/components/topbar-prototype/PrototypeSwitcher.astro";
import RoleBadge from "@/components/ui/RoleBadge.astro";
import { homeRouteForRole, isUserRole } from "@/lib/auth/roles";

interface Props {
  /** Szerokość kontenera: landing ma 1200 px, ekrany aplikacji 880 px (DESIGN.md §4). */
  container?: "page" | "narrow";
}

const { container = "narrow" } = Astro.props;
const { user, profile } = Astro.locals;

// Górny pasek prowadzi do przestrzeni roli, a nie do wspólnego panelu - adres i etykieta
// pochodzą z tabeli decyzyjnej, więc nie rozjadą się z regułami middleware.
const role = isUserRole(profile?.role) ? profile.role : null;
const homeRoute = role ? homeRouteForRole(role) : null;

// PROTOTYP — do wyrzucenia. Pasek gościa w wariantach `?variant=0|A|B|C`, tylko w trybie dev.
// Pytanie: czy obok logo potrzebny jest napis „Nie jesteś zalogowany” i jak mają wyglądać linki.
const PROTO_VARIANTS = [
  { key: "0", name: "Obecny, z napisem" },
  { key: "A", name: "Bez napisu" },
  { key: "B", name: "Załóż konto wyróżnione" },
  { key: "C", name: "Tylko logowanie" },
];
const protoParam = import.meta.env.DEV ? Astro.url.searchParams.get("variant") : null;
const protoVariant = PROTO_VARIANTS.some((v) => v.key === protoParam) ? protoParam : "0";
---

{
  /* `nav--guest`: tylko u gościa obok logo stoją dwa linki — do tego wariantu
     przypięte są ciaśniejsze odstępy i mniejsze logo na wąskim ekranie (style niżej). */
}
<header class:list={["nav", !user && "nav--guest"]}>
  <div class:list={[container === "page" ? "container-page" : "container-narrow", "nav-inner"]}>
    <a href="/" class="brand"><Logo layout="compact" /></a>
    {
      user ? (
        /* Zalogowany ma cztery rzeczy do pokazania: markę, adres, rolę i dwie akcje.
           Na telefonie nie mieszczą się w jednym rzędzie, więc chowają się pod
           przyciskiem menu. `<details>` robi to natywnie — bez JavaScriptu, z obsługą
           klawiatury i `aria-expanded` od przeglądarki. Powyżej `md` przycisk znika,
           a zawartość wraca do paska (patrz reguły `.menu` w stylach). */
        <>
          {/* Pole wyboru jest tu przełącznikiem menu, bo `<details>` się nie nadaje:
              jego zawartość siedzi w shadow DOM za slotem, więc powyżej `md`, gdy
              panel ma wrócić do paska, adres wychodził z zerową szerokością.
              Tu kontenerem jest zwykły `<div>` i układ zachowuje się przewidywalnie.
              Bez JavaScriptu, fokus dostaje ukryte pole, a etykieta je przełącza. */}
          <input type="checkbox" id="nav-menu" class="menu-toggle" />
          <label for="nav-menu" class="menu-button" aria-label="Menu konta">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 6h16" />
              <path d="M4 12h16" />
              <path d="M4 18h16" />
            </svg>
          </label>
          <div class="menu-body">
            <span class="nav-user">
              <span class="nav-mail">{user.email}</span>
              {role && <RoleBadge role={role} />}
            </span>
            <div class="nav-links">
              {homeRoute && <a href={homeRoute}>Mój panel</a>}
              <form method="POST" action="/api/auth/signout">
                <button type="submit">Wyloguj się</button>
              </form>
            </div>
          </div>
        </>
      ) : (
        <>
          {/* Gość: na wąskim ekranie ten napis znika, bo stojące obok „Zaloguj się"
              i „Załóż konto" mówią to samo, a pasek łamał się przez niego na trzy
              rzędy. Zalogowany zachowuje swój wiersz — tam adres i rola niosą treść. */}
          {protoVariant === "0" && (
            <span class="nav-user nav-user--guest">
              <span class="nav-mail">Nie jesteś zalogowany</span>
            </span>
          )}
          {protoVariant === "C" ? (
            <div class="nav-links">
              <a href="/auth/signin" class="proto-outline">
                Zaloguj się
              </a>
            </div>
          ) : (
            <div class="nav-links">
              <a href="/auth/signin">Zaloguj się</a>
              <a href="/auth/signup" class:list={[protoVariant === "B" && "proto-cta"]}>
                Załóż konto
              </a>
            </div>
          )}
        </>
      )
    }
  </div>
</header>

{protoParam !== null && !user && <PrototypeSwitcher variants={PROTO_VARIANTS} current={protoVariant} />}

<style>
  /* DESIGN.md §4: sticky 68 px, białe tło z rozmyciem, hairline na dole. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: var(--nav-h);
    display: flex;
    align-items: center;
    background: oklch(100% 0 0 / 0.82);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--border);
  }

  /* Mobile: marka i linki w pierwszym rzędzie, adres e-mail zawija się do drugiego. */
  .nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding-block: 12px;
  }

  /* Rozmiar logo zwartego; krój, wagę i kolory niesie samo `Logo` (DESIGN.md §4). */
  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    font-size: 21px;
  }
  .brand:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
    border-radius: 8px;
  }

  .nav-user {
    order: 3;
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .nav-mail {
    font-size: 13.5px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-links {
    order: 2;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-links a,
  .nav-links button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 14px;
    border: 0;
    border-radius: 999px;
    background: none;
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .nav-links a:hover,
  .nav-links button:hover {
    color: var(--primary-strong);
    background: var(--primary-soft);
  }
  .nav-links a:focus-visible,
  .nav-links button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* PROTOTYP — warianty B i C paska gościa. */
  .nav-links a.proto-cta {
    color: var(--on-primary, #fff);
    background: var(--primary);
    font-weight: 600;
  }
  .nav-links a.proto-cta:hover {
    color: var(--on-primary, #fff);
    background: var(--primary-strong);
  }
  .nav-links a.proto-outline {
    color: var(--primary-strong);
    border: 1px solid var(--border);
    font-weight: 600;
  }

  /* ── Menu konta (tylko zalogowany) ────────────────────────────────────── */
  .menu-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .menu-button {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44 px to minimalny cel dotykowy - PRD wymaga wygody na telefonie. */
    width: 44px;
    height: 44px;
    border-radius: 999px;
    color: var(--fg);
    cursor: pointer;
    transition: background 0.15s;
  }
  .menu-button:hover {
    background: var(--primary-soft);
  }
  /* Fokus trafia w ukryte pole, więc obwódkę rysujemy na etykiecie obok niego. */
  .menu-toggle:focus-visible + .menu-button {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .menu-button svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* Rozwinięcie nakłada się na treść zamiast rozpychać sticky pasek. */
  .menu-body {
    display: none;
    position: absolute;
    right: 18px;
    top: calc(100% + 8px);
    z-index: 60;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    min-width: min(280px, calc(100vw - 36px));
    padding: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-md);
  }
  .menu-toggle:checked ~ .menu-body {
    display: flex;
  }
  .menu-body .nav-user {
    order: 0;
    flex-basis: auto;
    flex-wrap: wrap;
    padding: 4px 10px 10px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 4px;
  }
  .menu-body .nav-mail {
    /* W rozwinięciu adres ma miejsce, żeby się złamać zamiast urwać wielokropkiem. */
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .menu-body .nav-links {
    order: 0;
    margin-left: 0;
    flex-direction: column;
    align-items: stretch;
  }
  .menu-body .nav-links a,
  .menu-body .nav-links button,
  .menu-body .nav-links form {
    width: 100%;
  }
  .menu-body .nav-links a,
  .menu-body .nav-links button {
    justify-content: flex-start;
  }

  /* Poniżej progu łamania pasek musi zmieścić markę i linki w jednym rzędzie.
     Zmierzone na produkcji: przy 360 px marka i linki zajmowały 343 px przy 324 px
     dostępnych, więc schodziły do osobnych rzędów. Ciaśniejsze pigułki i mniejsza
     marka mieszczą je także na 320 px. */
  @media (width < 768px) {
    .nav-user--guest {
      display: none;
    }
    .brand {
      font-size: 19px;
    }
    .nav-links a,
    .nav-links button {
      padding: 8px 10px;
      font-size: 14px;
    }
  }

  /* Tylko pasek gościa: logo „getona.horse” jest szersze od dawnego napisu (117 px
     przy 19 px kroju) i stoi obok dwóch linków, więc odstęp maleje do 8 px,
     a poniżej 360 px logo i pigułki zwężają się jeszcze raz: 92 + 8 + 179 px przy
     284 px dostępnych. U zalogowanego obok logo stoi sam przycisk menu — tam poza
     logo nic się nie zmienia, także linki w rozwinięciu menu. */
  @media (width < 768px) {
    .nav--guest .nav-inner {
      column-gap: 8px;
    }
  }
  @media (width < 360px) {
    .nav--guest .brand {
      font-size: 15px;
    }
    .nav--guest .nav-links a {
      padding: 8px 6px;
    }
  }

  /* Prototyp łamie układ przy 720 px; w aplikacji trzymamy się skali Tailwinda (md). */
  @media (width >= 768px) {
    /* Powyżej progu menu przestaje być menu: przycisk znika, a panel wraca do
       paska jako zwykły blok w rzędzie, niezależnie od stanu przełącznika. */
    .menu-button {
      display: none;
    }
    .menu-body,
    .menu-toggle:checked ~ .menu-body {
      display: flex;
      position: static;
      flex: 1;
      min-width: 0;
      flex-direction: row;
      align-items: center;
      gap: 16px;
      padding: 0;
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }
    .menu-body .nav-user {
      padding: 0;
      border-bottom: 0;
      margin-bottom: 0;
    }
    .menu-body .nav-mail {
      white-space: nowrap;
    }
    .menu-body .nav-links {
      flex-direction: row;
      margin-left: auto;
    }

    .nav-inner {
      flex-wrap: nowrap;
      padding-block: 0;
      min-height: var(--nav-h);
    }
    .nav-user {
      order: 0;
      flex-basis: auto;
      margin-left: 12px;
    }
    .nav-links {
      order: 0;
    }
  }
</style>
