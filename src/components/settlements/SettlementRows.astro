---
// Lista rozliczeń miesiąca: stawka ośrodka w miesiącu, jeździec z liczbą jazd i kwotą, na końcu suma
// „Razem: …”. Bez stawki ośrodka — jeźdźcy i jazdy bez kwot i zdanie, że kwoty czekają na stawkę.
// Cały wiersz to link do rozliczenia jeźdźca tego samego miesiąca (#95).
// Renderuje listę z `SettlementsView` (`@/lib/settlements/settlements`) — kolejność, kwoty i adresy
// są już policzone.
//
// Jeździec ze stawką indywidualną (#97) ma przy liczbie jazd dopisek „stawka indywidualna”; reszta płaci
// stawkę ośrodka z wiersza nad listą.
//
// KONTRAKT e2e: `list` „Rozliczenia jeźdźców”, jedna pozycja na jeźdźca: link z nazwą, „N jazd…”, kwotą.
import Card from "@/components/ui/Card.astro";
import Tag from "@/components/ui/Tag.astro";
import type { SettlementsView } from "@/lib/settlements/settlements";
import { SETTLEMENT_TEXTS } from "@/lib/settlements/texts";

interface Props {
  list: SettlementsView["list"];
  /** Np. `Stawka ośrodka w październiku 2026: 120,00 zł`; `null` — bez stawki. */
  monthRateText: string | null;
}

const { list, monthRateText } = Astro.props;
const texts = SETTLEMENT_TEXTS;
---

{monthRateText && <p class="rate mono-nums">{monthRateText}</p>}
<Card padding={0}>
  <ul class="riders" aria-label={texts.ridersList}>
    {
      list.rows.map((row) => (
        <li class="rider">
          <a class="rider__link" href={row.href}>
            <span class="rider__name">{row.name}</span>
            <span class="rider__count mono-nums">{row.ridesText}</span>
            {row.rate?.source === "individual" && <Tag>{texts.rider.source.individual}</Tag>}
            {row.dueText && <span class="rider__due mono-nums">{row.dueText}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</Card>
{list.totalText ? <p class="total mono-nums">{list.totalText}</p> : <p class="note">{texts.amountsNeedRate}</p>}

<style>
  .rate {
    margin: 0 0 10px;
    font-size: 14px;
    color: var(--muted);
  }
  .riders {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rider + .rider {
    border-top: 1px solid var(--border);
  }
  .rider__link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    min-height: 52px;
    padding: 8px 16px;
    color: inherit;
  }
  .rider__link:hover .rider__name {
    color: var(--primary);
    text-decoration: underline;
  }
  .rider__link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
    border-radius: var(--r);
  }
  .rider__name {
    flex: 1 1 12ch;
    min-width: 0;
    font-weight: 600;
    color: var(--primary);
    overflow-wrap: anywhere;
  }
  .rider__count {
    flex: none;
    font-size: 14px;
    color: var(--muted);
  }
  .rider__due {
    flex: none;
    min-width: 11ch;
    text-align: right;
    font-weight: 600;
  }
  .total {
    margin: 12px 0 0;
    font-size: 17px;
    font-weight: 600;
    text-align: right;
  }
  .note {
    margin: 12px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
</style>
