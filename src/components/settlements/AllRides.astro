---
// Pełna lista jazd w rozliczeniu jeźdźca (#109), pod kartą rozliczenia: karta (`Card`) ze zwijaną sekcją
// (`Disclosure`, natywne <details>, domyślnie zwinięte) z nagłówkiem „Pokaż wszystkie jazdy (N)”; w środku
// wspólna lista jazd Podsumowania miesiąca (`RideList`, bez zmian). W miesiącu bez jazd strona tej sekcji
// nie renderuje. Renderuje `RiderSettlementView` z `@/lib/settlements/rider` — nagłówek i wiersze są już
// policzone.
//
// KONTRAKT e2e: `summary` z tekstem „Pokaż wszystkie jazdy (N)”; po rozwinięciu `list` „Jazdy — {jeździec}”,
// jedna pozycja na jazdę.
import RideList from "@/components/month-summary/RideList.astro";
import Card from "@/components/ui/Card.astro";
import Disclosure from "@/components/ui/Disclosure.astro";
import type { SummaryRideRow } from "@/lib/month-summary/summary";
import { SETTLEMENT_TEXTS } from "@/lib/settlements/texts";

interface Props {
  /** Nagłówek, np. `Pokaż wszystkie jazdy (77)` (`RiderSettlementView.ridesToggle`). */
  toggle: string;
  rides: SummaryRideRow[];
  /** Nazwa jeźdźca w nazwie listy: `Jazdy — Anna Kowalska`. */
  riderName: string;
}

const { toggle, rides, riderName } = Astro.props;
---

<Card padding={0}>
  <Disclosure>
    <span slot="summary" class="toggle">{toggle}</span>
    <div class="list">
      <RideList rides={rides} label={`${SETTLEMENT_TEXTS.rider.ridesHeading} — ${riderName}`} />
    </div>
  </Disclosure>
</Card>

<style>
  .toggle {
    font-weight: 600;
    color: var(--primary);
  }
  /* Cały nagłówek jest celem — podkreślenie po najechaniu na dowolne jego miejsce. */
  :global(summary:hover) > .toggle {
    color: var(--primary-strong);
    text-decoration: underline;
  }
  .list {
    padding: 4px 18px 16px;
    border-top: 1px solid var(--border);
  }
</style>
