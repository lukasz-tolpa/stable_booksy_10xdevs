---
// Stawka ośrodka w bocznej kolumnie strony „Rozliczenia” (#94, układ wąskiej kolumny #105): stawka
// obowiązująca teraz albo prośba „Ustaw stawkę ośrodka”, zaplanowana zmiana z „Usuń zaplanowaną zmianę”
// i formularz nowej stawki „od tego / od następnego miesiąca”. Formularze bez JavaScriptu; ukryte pole
// `miesiac` wraca na oglądany miesiąc.
// Renderuje `StableRateView` z `@/lib/settlements/settlements`.
//
// KONTRAKT e2e: pole „Nowa stawka (zł)”, radia „Od tego miesiąca (…)” / „Od następnego miesiąca (…)”,
// przyciski „Zapisz stawkę” i „Usuń zaplanowaną zmianę”; zaplanowana zmiana to jeden element z tekstem
// „od {miesiąca} {rok}: {kwota}”.
import FormField from "@/components/settlements/FormField.astro";
import RateFromChoices from "@/components/settlements/RateFromChoices.astro";
import Card from "@/components/ui/Card.astro";
import GhostButton from "@/components/ui/GhostButton.astro";
import { MONTH_PARAM } from "@/lib/month-summary/month";
import type { StableRateView } from "@/lib/settlements/settlements";
import { SETTLEMENT_TEXTS } from "@/lib/settlements/texts";

interface Props {
  rate: StableRateView;
  /** Oglądany miesiąc `RRRR-MM` — formularze wracają na niego. */
  month: string;
}

const { rate, month } = Astro.props;
const texts = SETTLEMENT_TEXTS.rate;
---

<section aria-labelledby="rate-heading">
  <Card padding={18}>
    <h2 id="rate-heading" class="eyebrow">{texts.heading}</h2>
    {
      rate.currentText ? (
        <p class="current">
          {texts.current} <strong class="money">{rate.currentText}</strong>
        </p>
      ) : (
        <div class="missing">
          <p class="missing__ask">{texts.missing}</p>
          <p class="hint">{texts.missingHint}</p>
        </div>
      )
    }
    {
      rate.planned && (
        <div class="planned">
          <p>
            {texts.planned}: <span class="money">{rate.planned.text}</span>
          </p>
          <form method="post" action="/api/settlements/rate-delete">
            <input type="hidden" name={MONTH_PARAM} value={month} />
            <input type="hidden" name="rateId" value={rate.planned.id} />
            <GhostButton>{texts.deletePlanned}</GhostButton>
          </form>
        </div>
      )
    }

    <form method="post" action="/api/settlements/rate" class="change">
      <input type="hidden" name={MONTH_PARAM} value={month} />
      <FormField id="rate-amount" label={texts.amountLabel} name="amount" inputmode="decimal" />
      <RateFromChoices legend={texts.fromLegend} choices={rate.choices} />
      <div class="actions">
        <GhostButton>{texts.submit}</GhostButton>
        {rate.currentText && <p class="hint">{texts.changeHint}</p>}
      </div>
    </form>
  </Card>
</section>

<style>
  h2 {
    margin: 0 0 8px;
  }
  .money {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .current {
    margin: 0;
    font-size: 15px;
  }
  .current strong {
    font-size: 20px;
  }
  .missing__ask {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
  }
  .hint {
    margin: 4px 0 0;
    font-size: 13.5px;
    color: var(--muted);
  }
  .planned {
    display: grid;
    gap: 8px;
    justify-items: start;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .planned p {
    margin: 0;
    font-size: 14.5px;
  }
  .change {
    display: grid;
    gap: 14px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .actions {
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  .actions .hint {
    margin: 0;
  }
</style>
