---
// Sekcja kart jeźdźców na stronie „Rozliczenia” (#118: „Rekreacja” albo „Pensjonariusze”): nagłówek z sumą
// sekcji i „N jeźdźców · N jazd”, zdanie o brakującej stawce albo opłacie, potem karty (#105, wariant B
// prototypu): nazwa i „Do zapłaty”, pod nimi wyliczenie „N jazd × stawka [źródło stawki] = kwota za jazdy
// + opłata za pensjonat + koszty”, na dole „Rozliczenie →”. Cała karta to jeden link do rozliczenia jeźdźca
// oglądanego miesiąca. Bez stawki rodzaju sekcji karta ma samą liczbę jazd, a sekcja — zamiast sumy „—”.
// Stawka indywidualna ma dopisek wyróżniony, stawka ośrodka — neutralny.
// Renderuje `SettlementLinkSection` (`@/lib/settlements/settlements`) — kolejność, kwoty, adresy, teksty
// i wariant dopisku są już policzone.
//
// KONTRAKT e2e: `region` o nazwie sekcji („Rekreacja”, „Pensjonariusze”) z `list` „Rozliczenia jeźdźców —
// {sekcja}”, jedna pozycja na jeźdźca: link, którego tekst zaczyna się od nazwy; pierwsza kwota w pozycji to
// „Do zapłaty”, potem „N jazd…”. Suma sekcji to jeden element z samym tekstem „{sekcja} razem: {kwota}”
// — wizualnie ukryty; bez stawki rodzaju sekcji takiego elementu nie ma.
import Card from "@/components/ui/Card.astro";
import Tag from "@/components/ui/Tag.astro";
import type { SettlementLinkSection } from "@/lib/settlements/settlements";
import { SETTLEMENT_TEXTS } from "@/lib/settlements/texts";

interface Props {
  section: SettlementLinkSection;
}

const { section } = Astro.props;
const texts = SETTLEMENT_TEXTS;
const headingId = `section-${section.kind}`;
---

<section class="section" aria-labelledby={headingId}>
  <div class="section__head">
    <h2 id={headingId}>{section.heading}</h2>
    <p class="section__sum">
      {
        section.totalText ? (
          <>
            <span class="sr-only">{section.totalLabel}</span>
            <span class="section__amount" aria-hidden="true">
              {section.totalText}
            </span>
          </>
        ) : (
          <span class="section__amount">{texts.noTotal}</span>
        )
      }
    </p>
    <p class="section__counts">{section.countsText}</p>
  </div>
  {section.note && <p class="note">{section.note}</p>}
  <ul class="cards" aria-label={section.listLabel}>
    {
      section.rows.map((row) => (
        <li>
          <Card padding={0}>
            <a class="rider" href={row.href}>
              <span class="rider__top">
                <span class="rider__name">{row.name}</span>
                {row.dueText && (
                  <span class="rider__due">
                    <span class="rider__due-label">{texts.card.due}</span>
                    <span class="rider__amount">{row.dueText}</span>
                  </span>
                )}
              </span>
              <span class="rider__calc">
                <span>{row.ridesText}</span>
                {row.rateText && (
                  <>
                    <span>×</span>
                    <span>{row.rateText}</span>
                    {row.rateTag && <Tag variant={row.rateTag.variant}>{row.rateTag.text}</Tag>}
                    <span>=</span>
                    <span>{row.ridesAmountText}</span>
                  </>
                )}
                {row.feesText && (
                  <>
                    <span>+</span>
                    <span>{row.feesText}</span>
                  </>
                )}
                {row.costsText && (
                  <>
                    <span>+</span>
                    <span>{row.costsText}</span>
                  </>
                )}
              </span>
              <span class="rider__more">{texts.card.open}</span>
            </a>
          </Card>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 2px 12px;
    margin-bottom: 12px;
  }
  h2 {
    margin: 0;
    font-size: 20px;
    overflow-wrap: anywhere;
  }
  .section__sum {
    margin: 0;
    text-align: right;
  }
  .section__amount {
    font-size: 20px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .section__counts {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .note {
    margin: 0 0 12px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .cards {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rider {
    display: grid;
    gap: 8px;
    padding: 16px 18px;
    border-radius: var(--r-lg);
    color: inherit;
  }
  .rider:hover .rider__name {
    color: var(--primary);
    text-decoration: underline;
  }
  .rider:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .rider__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
  }
  .rider__name {
    min-width: 0;
    font-size: 18px;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .rider__due {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    margin-left: auto;
  }
  .rider__due-label {
    font-size: 13px;
    color: var(--muted);
  }
  .rider__amount {
    font-size: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .rider__calc {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-size: 14.5px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .rider__more {
    font-size: 14px;
    font-weight: 600;
    color: var(--primary);
  }
</style>
