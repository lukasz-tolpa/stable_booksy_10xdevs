---
// „Dopisz koszt” na stronie „Rozliczenia” (#96): koszt dodatkowy jeźdźcowi ośrodka za oglądany miesiąc
// — także takiemu, który w tym miesiącu nie miał jazd. Jeźdźcy do wyboru to konta z jakimkolwiek zapisem
// w ośrodku (`composeAddCost`). Formularz bez JavaScriptu wraca na listę tego miesiąca.
//
// KONTRAKT e2e: `region` „Dopisz koszt” z listą wyboru „Jeździec”, polami „Nazwa kosztu”, „Kwota (zł)”
// i przyciskiem „Dopisz koszt”.
import CostFields from "@/components/settlements/CostFields.astro";
import Card from "@/components/ui/Card.astro";
import GhostButton from "@/components/ui/GhostButton.astro";
import { MONTH_PARAM } from "@/lib/month-summary/month";
import type { AddCostView } from "@/lib/settlements/costs";
import { RIDER_PARAM } from "@/lib/settlements/redirect";
import { SETTLEMENT_TEXTS } from "@/lib/settlements/texts";

interface Props {
  form: AddCostView;
}

const { riders, month, hint } = Astro.props.form;
const texts = SETTLEMENT_TEXTS.costs;
---

<section class="section" aria-labelledby="add-cost-heading">
  <Card>
    <h2 id="add-cost-heading">{texts.add}</h2>
    {
      riders.length === 0 ? (
        <p class="hint">{texts.noRiders}</p>
      ) : (
        <form method="post" action="/api/settlements/cost" class="form">
          <input type="hidden" name={MONTH_PARAM} value={month} />
          <div class="field">
            <label for="cost-rider">{texts.riderLabel}</label>
            <select id="cost-rider" name={RIDER_PARAM} required>
              <option value="" selected>
                {texts.riderPlaceholder}
              </option>
              {riders.map((rider) => (
                <option value={rider.key}>{rider.name}</option>
              ))}
            </select>
          </div>
          <CostFields idPrefix="cost-add" />
          <div class="actions">
            <GhostButton>{texts.add}</GhostButton>
            <p class="hint">{hint}</p>
          </div>
        </form>
      )
    }
  </Card>
</section>

<style>
  .section {
    display: block;
    margin-top: 18px;
  }
  h2 {
    margin: 0 0 10px;
    font-size: 20px;
  }
  .form {
    display: grid;
    gap: 12px;
  }
  .field {
    display: grid;
    gap: 6px;
    max-width: 360px;
  }
  label {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted);
  }
  select {
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--border-2);
    border-radius: var(--r);
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: 15px;
  }
  select:focus-visible {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }
  .hint {
    margin: 0;
    font-size: 13.5px;
    color: var(--muted);
  }
</style>
