---
// „Pozostali jeźdźcy ośrodka” pod kartami na stronie „Rozliczenia” (#106): jeźdźcy ośrodka bez jazd
// i kosztów w oglądanym miesiącu. Zwijana sekcja `Disclosure` (natywne <details>), domyślnie zwinięta; w nagłówku
// liczba jeźdźców i dopisek. Każdy wiersz to link „Dopisz koszt →” do rozliczenia jeźdźca oglądanego
// miesiąca — koszt dodatkowy dopisuje się tylko tam. Pustej listy strona nie renderuje.
// Renderuje `SettlementsView.others` (`@/lib/settlements/settlements`) — kolejność i adresy są policzone.
//
// KONTRAKT e2e: `summary` z tekstem „Pozostali jeźdźcy ośrodka”; po rozwinięciu `list` „Pozostali jeźdźcy
// ośrodka”, w każdej pozycji link z nazwą jeźdźca i „Dopisz koszt →” w nazwie dostępnej.
import Disclosure from "@/components/ui/Disclosure.astro";
import type { OtherRider } from "@/lib/settlements/settlements";
import { SETTLEMENT_TEXTS } from "@/lib/settlements/texts";

interface Props {
  riders: OtherRider[];
}

const { riders } = Astro.props;
const texts = SETTLEMENT_TEXTS.others;
---

<div class="others">
  <Disclosure>
    <Fragment slot="summary">
      <span class="others__heading">{texts.heading}</span>
      <span class="others__count">{riders.length}</span>
      <span class="others__note">{texts.note}</span>
    </Fragment>
    <ul class="others__list" aria-label={texts.heading}>
      {
        riders.map((rider) => (
          <li>
            <a class="rider" href={rider.href}>
              <span class="rider__name">{rider.name}</span> <span class="rider__act">{texts.addCost}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Disclosure>
</div>

<style>
  .others {
    border: 1px dashed var(--border-2);
    border-radius: var(--r-lg);
  }
  .others__heading {
    font-weight: 600;
  }
  .others__count {
    padding: 0 8px;
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .others__note {
    font-size: 14px;
    color: var(--muted);
  }
  .others__list {
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
  }
  .rider {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 12px;
    min-height: 44px;
    padding: 8px 10px;
    border-radius: var(--r);
    color: var(--fg);
  }
  .rider:hover {
    background: var(--surface);
  }
  .rider:hover .rider__act {
    text-decoration: underline;
  }
  .rider:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .rider__name {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .rider__act {
    font-size: 14px;
    font-weight: 600;
    color: var(--primary);
    white-space: nowrap;
  }
</style>
