---
import { ChevronLeft, ChevronRight } from "lucide-react";
import Card from "@/components/ui/Card.astro";
import DayNav from "@/components/ui/DayNav.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import ScheduleDayForm from "@/components/schedule/ScheduleDayForm";
import { addDays, isPastDate } from "@/lib/schedule/dates";
import { formatLongDateWithYear } from "@/lib/format";
import { homeRouteForAccount } from "@/lib/auth/roles";
import { SCHEDULE_PERMISSION_LOST } from "@/lib/schedule/errors";
import {
  horseDefaults,
  instructorDefaults,
  pastDaySummary,
  placeDefaults,
  prefillSourceDay,
} from "@/lib/schedule/form";
import {
  getLatestScheduleDay,
  getScheduleDay,
  getScheduleStableId,
  type ScheduleDayData,
} from "@/lib/schedule/queries";
import { listStableInstructors, type InstructorListItem } from "@/lib/instructors/queries";
import { listStablePlaces, type PlaceListItem } from "@/lib/places/queries";
import { listStableHorses, type HorseListItem } from "@/lib/stables/queries";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

/**
 * Grafik dnia — wspólny dla właściciela (`/osrodek/grafik`) i instruktora z uprawnieniem do
 * układania grafiku (`/instruktor/grafik`, #79): te same odczyty, ten sam formularz, ten sam
 * endpoint zapisu. Ośrodek wybiera baza z sesji (`schedule_stable_id`), nie strona. Dostęp do
 * strony pilnuje middleware (mapa stanów konta w @/lib/auth/roles).
 */
interface Props {
  /** Adres strony grafiku — nawigacja po dniach zostaje na nim. */
  route: string;
  /** Dzień z adresu (`?dzien=`) albo domyślny. */
  day: string;
  /** Adres dodawania koni przy pustym stadzie; `null` — konto nie zarządza końmi (instruktor). */
  horsesRoute: string | null;
  /** Komunikat odmowy zapisu z adresu (`?error=`). */
  error: string | null;
}

const { route, day, horsesRoute, error } = Astro.props;
const { profile, instructorStanding } = Astro.locals;
const readOnly = isPastDate(day);

const supabase = createClient(Astro.request.headers, Astro.cookies);

let scheduleDay: ScheduleDayData | null = null;
let latestDay: ScheduleDayData | null = null;
let horses: HorseListItem[] = [];
let instructors: InstructorListItem[] = [];
let places: PlaceListItem[] = [];
let loadFailed = false;
// Uprawnienie odebrane między middleware a odczytem — to nie awaria, tylko brak dostępu do grafiku.
let permissionLost = false;

if (supabase && profile) {
  try {
    const stableId = await getScheduleStableId(supabase);
    if (stableId === null) {
      permissionLost = true;
    } else {
      [scheduleDay, latestDay, horses, instructors, places] = await Promise.all([
        getScheduleDay(supabase, stableId, day),
        getLatestScheduleDay(supabase, stableId),
        listStableHorses(supabase, stableId),
        listStableInstructors(supabase, stableId),
        listStablePlaces(supabase, stableId),
      ]);
    }
  } catch (error) {
    loadFailed = true;
    logError(`page:${route.slice(1)}`, error);
  }
} else {
  // Brak klienta Supabase lub profilu to awaria konfiguracji - bez tej gałęzi
  // strona pokazywałaby mylące "Nie masz jeszcze żadnych koni".
  loadFailed = true;
}

const horseForm = horseDefaults(scheduleDay, latestDay, horses);
const instructorForm = instructorDefaults(scheduleDay, latestDay, instructors);
const placeForm = placeDefaults(scheduleDay, latestDay, places);
// Obie strony grafiku leżą w przestrzeniach chronionych rolą `instructor` (middleware).
const home = homeRouteForAccount("instructor", instructorStanding);
const pastSummary = scheduleDay ? pastDaySummary(scheduleDay, horses, instructors) : null;

const dayLabel = formatLongDateWithYear(day);
---

<h1>Grafik dnia</h1>
<p class="page-lead">
  Zakres godzin, konie i instruktorzy pracujący danego dnia oraz limity miejsc. Zakres 10–16 oznacza jazdy od 10:00 do
  15:00.
</p>

<DayNav>
  <a slot="prev" href={`${route}?dzien=${addDays(day, -1)}`}>
    <ChevronLeft className="size-4" />
    Poprzedni
  </a>
  <Fragment slot="date">{dayLabel}</Fragment>
  <a slot="next" href={`${route}?dzien=${addDays(day, 1)}`}>
    Następny
    <ChevronRight className="size-4" />
  </a>
</DayNav>

{
  loadFailed ? (
    <FailureState>
      <p>Nie udało się wczytać grafiku.</p>
      <p>Odśwież stronę za chwilę.</p>
    </FailureState>
  ) : permissionLost ? (
    <Card>
      <EmptyState>
        <p>{SCHEDULE_PERMISSION_LOST}.</p>
        <a href={home}>Wróć na stronę startową</a>
      </EmptyState>
    </Card>
  ) : readOnly ? (
    <Card>
      <div class="past">
        <p class="past__flag">Dzień miniony — tylko do odczytu.</p>
        {pastSummary ? (
          <dl>
            <div>
              <dt>Godziny pracy</dt>
              <dd class="mono-nums">{pastSummary.hours}</dd>
            </div>
            <div>
              <dt>Konie</dt>
              <dd>{pastSummary.horseNames}</dd>
            </div>
            <div>
              <dt>Instruktorzy</dt>
              <dd>{pastSummary.instructorNames}</dd>
            </div>
          </dl>
        ) : (
          <p class="past__none">Tego dnia nie było ułożonego grafiku.</p>
        )}
      </div>
    </Card>
  ) : horses.length === 0 ? (
    <Card>
      <EmptyState>
        {horsesRoute ? (
          <>
            <p>
              Nie masz jeszcze żadnych koni. Grafik przydziela konie do godzin, więc bez stada nie ma czego układać.
            </p>
            <a href={horsesRoute}>Dodaj pierwszego konia</a>
          </>
        ) : (
          <p>Ośrodek nie ma jeszcze koni. Konie dodaje właściciel ośrodka — bez nich nie ma czego układać.</p>
        )}
      </EmptyState>
    </Card>
  ) : (
    <Card>
      <ScheduleDayForm
        day={day}
        openHour={horseForm.openHour}
        closeHour={horseForm.closeHour}
        selectedHorseIds={horseForm.selectedHorseIds}
        horses={horseForm.selectableHorses}
        selectedInstructorIds={instructorForm.selectedInstructorIds}
        instructors={instructorForm.selectableInstructors}
        seats={instructorForm.seats}
        places={placeForm.selectablePlaces}
        slotPlaces={placeForm.places}
        defaultPlaceId={placeForm.defaultPlaceId}
        choosePlace={placeForm.choosePlace}
        prefillFrom={prefillSourceDay(scheduleDay, latestDay)}
        serverError={error}
        client:load
      />
    </Card>
  )
}

<style>
  h1 {
    font-size: 32px;
  }
  .page-lead {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }

  /* ── Dzień miniony ────────────────────────────────────────────────────── */
  .past__flag {
    margin: 0;
    padding: 10px 14px;
    background: var(--surface-2);
    border-radius: var(--r);
    font-size: 13.5px;
    color: var(--muted);
  }
  .past dl {
    margin: 16px 0 0;
    display: grid;
    gap: 10px;
  }
  .past dt {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .past dd {
    margin: 2px 0 0;
    font-size: 15px;
    font-weight: 500;
  }
  .past__none {
    margin: 16px 0 0;
    color: var(--muted);
  }
</style>
