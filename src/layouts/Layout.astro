---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { PRODUCT_NAME } from "@/lib/brand";
import { missingConfigs } from "@/lib/config-status";
import { OG_IMAGE, jsonLd } from "@/lib/seo/home";
import { requireSite } from "@/lib/seo/site";
import { pageTitle } from "@/lib/seo/title";

/**
 * Cały `<head>` składa się tutaj (#65) — strony podają tylko te właściwości
 * i niczego nie dopisują do `<head>` same.
 */
interface Props {
  /** Nazwa strony; układ dopisuje do niej „ – getona.horse” (`pageTitle`). Bez niej tytuł to sama nazwa produktu. */
  title?: string;
  /** Pełny tytuł bez dopisku — tylko strona główna, której tytuł zaczyna się od nazwy produktu (#66). */
  fullTitle?: string;
  /** Opis dla wyników wyszukiwania (`<meta name="description">`); bez niego znacznika nie ma. */
  description?: string;
  /** Zakaz indeksowania (`noindex, follow`) — logowanie, rejestracja, potwierdzenie e-maila, 404. */
  noindex?: boolean;
  /**
   * Adres kanoniczny i podgląd linku (Open Graph, karta Twittera) — tylko strona główna (#66).
   * Adresy budowane z `site` w astro.config.mjs, tytuł i opis z `title` i `description`.
   */
  linkPreview?: boolean;
  /** Dane strukturalne schema.org wstawiane jako jeden blok JSON-LD. */
  structuredData?: object;
}

const { title: name, fullTitle, description, noindex = false, linkPreview = false, structuredData } = Astro.props;
const title = fullTitle ?? pageTitle(name);

const site = linkPreview ? requireSite(Astro.site, "podgląd linku nie zbuduje adresów") : undefined;
const pageUrl = site ? new URL(Astro.url.pathname, site).href : undefined;
const imageUrl = site ? new URL(OG_IMAGE.path, site).href : undefined;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      pageUrl && imageUrl && (
        <>
          <link rel="canonical" href={pageUrl} />
          <meta property="og:type" content="website" />
          <meta property="og:locale" content="pl_PL" />
          <meta property="og:site_name" content={PRODUCT_NAME} />
          <meta property="og:url" content={pageUrl} />
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:width" content={String(OG_IMAGE.width)} />
          <meta property="og:image:height" content={String(OG_IMAGE.height)} />
          <meta property="og:image:alt" content={OG_IMAGE.alt} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {
      structuredData && (
        // eslint-disable-next-line astro/no-set-html-directive -- JSON-LD z naszych stałych; `jsonLd` zabezpiecza `</script>`.
        <script type="application/ld+json" is:inline set:html={jsonLd(structuredData)} />
      )
    }
    <!-- Jasny motyw jako jedyny (DESIGN.md §1) - bez tego przeglądarka mogłaby
         przemalować kontrolki formularzy pod systemowy tryb ciemny. -->
    <meta name="color-scheme" content="light" />
    <!-- Znak: biała głowa konia na zieleni marki. Trzy rozmiary, bo kafelek na
         ekranie startowym iOS-a bierze `apple-touch-icon`, a nie favicon. -->
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- DESIGN.md §3: Plus Jakarta Sans (display) + Inter (body), jeden arkusz.
         `display=swap` i fallback system-ui w @theme sprawiają, że brak Google Fonts
         opóźnia tylko krój, nie pierwsze malowanie. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
  html {
    /* Tło na <html>, żeby przewijanie poza treść nie odsłaniało bieli przeglądarki. */
    background: var(--bg);
  }
  body {
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
</style>
