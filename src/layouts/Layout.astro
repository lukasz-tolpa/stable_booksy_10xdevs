---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { title = "Stable Booksy" } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Jasny motyw jako jedyny (DESIGN.md §1) - bez tego przeglądarka mogłaby
         przemalować kontrolki formularzy pod systemowy tryb ciemny. -->
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- DESIGN.md §3: Plus Jakarta Sans (display) + Inter (body), jeden arkusz.
         `display=swap` i fallback system-ui w @theme sprawiają, że brak Google Fonts
         opóźnia tylko krój, nie pierwsze malowanie. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
  html {
    /* Tło na <html>, żeby przewijanie poza treść nie odsłaniało bieli przeglądarki. */
    background: var(--bg);
  }
  body {
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
</style>
