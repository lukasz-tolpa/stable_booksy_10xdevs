---
import { Check } from "lucide-react";
import Banner from "@/components/Banner.astro";
import Logo from "@/components/Logo.astro";
import Topbar from "@/components/Topbar.astro";
import DayTimeline from "@/components/landing/DayTimeline.astro";
import Card from "@/components/ui/Card.astro";
import Layout from "@/layouts/Layout.astro";
import { HOME_DESCRIPTION, HOME_TITLE, homeStructuredData } from "@/lib/seo/home";
import { requireSite } from "@/lib/seo/site";
import { landingEntries } from "@/lib/auth/landing";
import { slotStatusLabel } from "@/lib/bookings/slots";
import { formatClockHour, formatFreeSeats } from "@/lib/format";
import { DAY_CLOSING_HEADING } from "@/lib/landing/day";
import { landingDemo } from "@/lib/landing/demo";
import type { UserRole } from "@/types";

// Nieudane wylogowanie wraca tutaj z komunikatem w ?error= (ten sam wzorzec co na
// pozostałych stronach; treść jest polska i pochodzi z @/lib/auth/errors).
const error = Astro.url.searchParams.get("error");

// Co stoi w każdej połowie (rejestracja roli, „Mój panel” albo nic), czy jest linia
// o logowaniu i które przyciski powtarza zamknięcie sekcji „Jeden dzień”, rozstrzyga
// `landingEntries` - strona tylko to rysuje.
const { user, profile } = Astro.locals;
const entries = landingEntries(user ? { profileRole: profile?.role } : null);

// Wygląd przycisku roli: w połowie (na jej kolorowym tle) i w zamknięciu (na jasnym tle).
const CTA_CLASS = {
  half: { rider: "cta--rider", stable: "cta--stable" },
  closing: { rider: "cta--rider", stable: "cta--stable-solid" },
} as const satisfies Record<string, Record<UserRole, string>>;

// Obie ilustracje rysują ten sam dzień z jednego źródła, tymi samymi regułami co prawdziwe widoki.
const demo = landingDemo();

// Wyniki wyszukiwania i podgląd linku (#66); adresy z `site` w astro.config.mjs.
const structuredData = homeStructuredData(requireSite(Astro.site, "dane strukturalne nie zbudują adresów"));
---

<Layout fullTitle={HOME_TITLE} description={HOME_DESCRIPTION} linkPreview structuredData={structuredData}>
  {error && <Banner variant="error">{error}</Banner>}
  <Topbar container="page" />
  <!-- DESIGN.md §6: dwie połowy zamiast hero. Tła sięgają krawędzi okna, treść każdej
       połowy ma własną szerokość i dosuwa się do środka strony. Pod nimi „Jeden dzień”.
       Sekcje są regionami nazwanymi swoim nagłówkiem: przyciski połów i zamknięcia mają
       te same nazwy, więc rozróżnia je region (test-plan §6.3). -->
  <main class="landing">
    <div class="halves">
      <!-- Frazy pod hasłami (#67) są tekstem, nie nagłówkami: struktura h1/h2 połów
           zostaje bez zmian. Treść ta sama dla gościa i zalogowanego. -->
      <section class="half half--rider" aria-labelledby="rider-heading">
        <div class="half__inner">
          <hgroup class="half__head">
            <h1 id="rider-heading" class="half__title">Jeżdżę konno.</h1>
            <p class="half__phrase">Zapisy na jazdy konne online</p>
          </hgroup>
          <ul class="points">
            <li>Widzisz wolne miejsca u każdego instruktora.</li>
            <li>Zapisujesz się jednym kliknięciem.</li>
            <li>Odwołujesz sam, bez tłumaczenia się przez telefon.</li>
          </ul>

          <!-- Ilustracja, nie kontrolki: bez <button>, ukryta przed czytnikami, opisana zdaniem niżej.
               Wyjątek: „Zapisz się” jest skrótem dla myszy i dotyku (`bookRoute` z `landingEntries`).
               `tabindex="-1"`, bo leży w drzewie `aria-hidden`; klawiatura i czytnik mają ten sam
               cel w pasku („Zaloguj się”, „Mój panel”) i w przycisku połowy. -->
          <div class="demo" aria-hidden="true">
            <Card padding={16}>
              {
                demo.riderHours.map((entry) => (
                  <div class="demo-hourgroup">
                    <span class="demo-hour mono-nums">{formatClockHour(entry.hour)}</span>
                    {entry.slots.map((slot) => {
                      const label = slotStatusLabel(slot.status);
                      return (
                        <div class="demo-slot">
                          <span class="demo-slot__who">{slot.instructorName}</span>
                          <span class="demo-slot__seats mono-nums">{formatFreeSeats(slot.freeSeats, slot.seats)}</span>
                          {label === null ? (
                            entries.bookRoute ? (
                              <a class="demo-slot__pill demo-slot__pill--book" href={entries.bookRoute} tabindex="-1">
                                Zapisz się
                              </a>
                            ) : (
                              <span class="demo-slot__pill demo-slot__pill--book">Zapisz się</span>
                            )
                          ) : (
                            <span class:list={["demo-slot__pill", slot.status === "mine" && "demo-slot__pill--mine"]}>
                              {slot.status === "mine" && <Check className="size-[15px]" />}
                              {label}
                            </span>
                          )}
                        </div>
                      );
                    })}
                  </div>
                ))
              }
            </Card>
          </div>
          <p class="sr-only">Ilustracja: lista wolnych miejsc u instruktorów w kolejnych godzinach.</p>

          {
            entries.rider && (
              <a class:list={["cta", CTA_CLASS.half.rider]} href={entries.rider.href}>
                {entries.rider.label}
              </a>
            )
          }
        </div>
      </section>

      <section class="half half--stable text-primary-foreground" aria-labelledby="stable-heading">
        <div class="half__inner">
          <hgroup class="half__head">
            <h2 id="stable-heading" class="half__title">Prowadzę ośrodek.</h2>
            <p class="half__phrase">System zapisów dla ośrodka jeździeckiego</p>
          </hgroup>
          <ul class="points text-primary-foreground/85">
            <li>Układasz grafik dnia: godziny, konie, instruktorzy.</li>
            <li>Ustalasz limit miejsc; aplikacja pilnuje liczby koni.</li>
            <li>Przydzielasz konie i widzisz obłożenie.</li>
          </ul>

          <div class="demo" aria-hidden="true">
            <Card padding={16}>
              <div class="sheet" style={`--sheet-cols:${String(demo.sheet.instructors.length)}`}>
                <span class="sheet__head">Godzina</span>
                {demo.sheet.instructors.map((name) => <span class="sheet__head sheet__head--seat">{name}</span>)}
                <span class="sheet__head sheet__head--fill">Koni zajętych</span>

                {
                  demo.sheet.rows.map((row) => (
                    <>
                      <span class="sheet__cell mono-nums">{formatClockHour(row.hour)}</span>
                      {row.seats.map((seats) => (
                        <span class="sheet__cell sheet__cell--seat">
                          <span class:list={["seat", "mono-nums", seats > 0 && "seat--set"]}>{seats}</span>
                        </span>
                      ))}
                      <span class="sheet__cell sheet__cell--fill">
                        {row.fill === "full" && (
                          <span class="full">
                            <Check className="size-3.5 shrink-0" />
                            pełna
                          </span>
                        )}
                        <span class="fill mono-nums">
                          {row.total} / {demo.sheet.horseCount}
                        </span>
                      </span>
                    </>
                  ))
                }
              </div>
            </Card>
          </div>
          <p class="sr-only">
            Ilustracja: arkusz limitów miejsc z kolumną „Koni zajętych” i godziną oznaczoną jako pełna.
          </p>

          {
            entries.stable && (
              <a class:list={["cta", CTA_CLASS.half.stable]} href={entries.stable.href}>
                {entries.stable.label}
              </a>
            )
          }
        </div>
      </section>

      {
        entries.signInRoute && (
          <p class="signin">
            Masz już konto? <a href={entries.signInRoute}>Zaloguj się</a>
          </p>
        )
      }
    </div>

    <DayTimeline />

    <section class="closing container-page" aria-labelledby="closing-heading">
      <h2 id="closing-heading" class="landing-heading">{DAY_CLOSING_HEADING}</h2>
      <!-- Zdanie definiujące (#67) stoi tu, a nie nad połowami: nad nimi rozbijało pierwszy widok. -->
      <p class="definition">
        getona.horse to aplikacja do zapisów na jazdy konne: jeździec zapisuje się na wolne miejsce u instruktora, a
        ośrodek jeździecki układa grafik dnia i przydziela konie.
      </p>
      {
        entries.closing.length > 0 && (
          <div class="closing__actions">
            {entries.closing.map(({ role, label, href }) => (
              <a class:list={["cta", CTA_CLASS.closing[role]]} href={href}>
                {label}
              </a>
            ))}
          </div>
        )
      }
    </section>
  </main>
  <!-- DESIGN.md §6: stopka to drugie ciemne tło strony i niesie wyłącznie logo pełne. -->
  <footer class="foot">
    <div class="container-page">
      <Logo surface="dark" />
    </div>
  </footer>
</Layout>

<style>
  /* ── Układ: jedna pod drugą, od 900 px obok siebie na wysokość okna ───── */
  .landing {
    background: var(--bg);
  }
  .halves {
    display: grid;
  }
  .half {
    display: grid;
    align-items: center;
    padding: 48px clamp(18px, 5vw, 88px);
  }
  .half--rider {
    background: var(--accent-soft);
    color: var(--fg);
  }
  /* Ciemne tło sekcji - obok stopki jedno z dwóch w aplikacji (DESIGN.md §1); biel tekstu daje utility. */
  .half--stable {
    background: var(--primary-strong);
  }
  .half__inner {
    display: grid;
    gap: 28px;
    justify-items: start;
    justify-self: center;
    width: 100%;
    max-width: 520px;
    /* Element siatki domyślnie nie zwęża się poniżej treści - bez tego ilustracja
       rozpychałaby połowę na 390 px. */
    min-width: 0;
  }
  @media (width >= 900px) {
    .halves {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr auto;
      /* 1 px to hairline pod górnym paskiem - bez niego strona przewijałaby się o piksel. */
      min-height: calc(100dvh - var(--nav-h) - 1px);
    }
    /* Treść zaczyna się na tej samej wysokości w obu połowach, więc nagłówki stoją
       w jednej linii mimo różnej wysokości ilustracji. */
    .half {
      align-items: start;
      padding-block: clamp(56px, 11vh, 140px) 56px;
    }
    .half--rider .half__inner {
      justify-self: end;
    }
    .half--stable .half__inner {
      justify-self: start;
    }
  }

  /* Zdanie definiujące pod nagłówkiem zamknięcia: na `--bg`, tekst `--fg` (DESIGN.md §6). */
  .definition {
    max-width: 760px;
    margin: 0;
    text-align: center;
    font-size: 17px;
    line-height: 1.5;
    color: var(--fg);
  }

  .half__head {
    display: grid;
    gap: 14px;
  }
  /* Fraza pod hasłem: krój display 600, w kolorze tekstu swojej połowy (`--fg` / biel). */
  .half__phrase {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(19px, 1.7vw, 23px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  /* h1 i h2 wyglądają tak samo; większa skala niż §3 to wyjątek landingu (§6). */
  .half__title {
    margin: 0;
    font-size: clamp(44px, 5.8vw, 86px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .half--rider .half__title {
    color: var(--accent-ink);
  }
  .points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    font-size: 18px;
    line-height: 1.4;
  }

  /* ── Ilustracje interfejsu w białej karcie ────────────────────────────── */
  .demo {
    width: 100%;
    min-width: 0;
    color: var(--fg);
    /* Karta zachowuje swój hairline; na kolorowym tle opakowanie dokłada jej cień overlayu. */
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-md);
  }

  /* Fragment listy slotów - proporcje ze strony ośrodka jeźdźca. */
  .demo-hourgroup + .demo-hourgroup {
    margin-top: 14px;
  }
  .demo-hour {
    display: block;
    margin-bottom: 10px;
    font-size: 14px;
    font-weight: 600;
  }
  .demo-slot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding: 8px 8px 8px 14px;
    border: 1px solid var(--border);
    border-radius: var(--r);
  }
  .demo-slot + .demo-slot {
    margin-top: 8px;
  }
  .demo-slot__who {
    font-weight: 600;
    font-size: 14.5px;
  }
  .demo-slot__seats {
    font-size: 13.5px;
    color: var(--muted);
  }
  .demo-slot__pill {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }
  .demo-slot__pill--book {
    border-color: var(--border-2);
    box-shadow: var(--shadow-sm);
  }
  a.demo-slot__pill--book {
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  a.demo-slot__pill--book:hover {
    background: var(--primary-soft);
    border-color: var(--primary);
  }
  .demo-slot__pill--mine {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  /* Fragment arkusza limitów - siatka zamiast tabeli, bo to rysunek, nie dane. */
  .sheet {
    display: grid;
    grid-template-columns: auto repeat(var(--sheet-cols), 1fr) auto;
    font-size: 14.5px;
  }
  .sheet__head {
    padding: 2px 6px 10px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted);
  }
  .sheet__cell {
    display: flex;
    align-items: center;
    min-height: 50px;
    padding: 8px 6px;
    border-top: 1px solid var(--border);
  }
  .sheet__head--seat,
  .sheet__cell--seat {
    text-align: center;
    justify-content: center;
  }
  .sheet__head--fill,
  .sheet__cell--fill {
    text-align: right;
    justify-content: flex-end;
  }
  .sheet__cell--fill {
    flex-wrap: wrap;
    gap: 2px 8px;
  }
  .seat {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    padding: 5px 8px;
    border: 1px solid var(--border-2);
    border-radius: var(--r-sm);
    font-size: 15px;
    color: var(--muted);
  }
  .seat--set {
    border-color: var(--primary);
    background: var(--primary-soft);
    color: var(--fg);
    font-weight: 600;
  }
  .fill {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }
  .full {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--success-soft);
    color: var(--success-ink);
    font-size: 12px;
    font-weight: 600;
  }

  /* ── Przyciski połów ──────────────────────────────────────────────────── */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Na telefonie przycisk na całą szerokość - wygodny dla kciuka (DESIGN.md §4). */
    width: 100%;
    min-height: 54px;
    padding: 15px 28px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition:
      background 0.15s,
      transform 0.08s;
  }
  @media (width >= 560px) {
    .cta {
      width: auto;
    }
  }
  .cta:active {
    transform: translateY(1px);
  }
  .cta--rider {
    background: var(--accent);
    color: var(--color-primary-foreground);
  }
  .cta--rider:hover {
    background: var(--accent-ink);
  }
  .cta--rider:focus-visible {
    outline: 2px solid var(--primary-strong);
    outline-offset: 3px;
  }
  .cta--stable {
    background: var(--surface);
    color: var(--fg);
  }
  .cta--stable:hover {
    background: var(--primary-soft);
  }
  /* Zielony obrys zniknąłby na zielonym tle - tu obrys jest biały jak tekst połowy. */
  .cta--stable:focus-visible {
    outline: 2px solid var(--color-primary-foreground);
    outline-offset: 3px;
  }

  /* Na jasnym tle zamknięcia sekcji przycisk ośrodka jest pełny, w zieleni swojej połowy. */
  .cta--stable-solid {
    background: var(--primary-strong);
    color: var(--color-primary-foreground);
  }
  .cta--stable-solid:hover {
    background: var(--primary);
  }
  .cta--stable-solid:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ── Zamknięcie sekcji „Jeden dzień” ──────────────────────────────────── */
  .closing {
    display: grid;
    gap: 32px;
    justify-items: center;
    padding-block: 72px 96px;
    text-align: center;
  }
  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    width: 100%;
  }

  /* ── Stopka: logo pełne na zieleni połowy ośrodka ─────────────────────── */
  .foot {
    padding-block: 56px 64px;
    background: var(--primary-strong);
    /* Rozmiar logo w stopce; krój, wagę, wiersze i kolory niesie `Logo`. */
    font-size: clamp(56px, 9vw, 88px);
  }

  /* ── Linia o logowaniu pod połowami ───────────────────────────────────── */
  .signin {
    grid-column: 1 / -1;
    margin: 0;
    padding: 22px 18px;
    text-align: center;
    font-size: 16px;
  }
  .signin a {
    font-weight: 600;
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 4px;
    border-radius: 4px;
  }
  .signin a:hover {
    color: var(--primary-strong);
  }
  .signin a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }
</style>
