---
import { CalendarX2, Check, ChevronLeft, ChevronRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import RejectBookingForm from "@/components/bookings/RejectBookingForm.astro";
import Topbar from "@/components/Topbar.astro";
import Card from "@/components/ui/Card.astro";
import GhostButton from "@/components/ui/GhostButton.astro";
import DayNav from "@/components/ui/DayNav.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import Tag from "@/components/ui/Tag.astro";
import { listBoardingHorses } from "@/lib/boarding/queries";
import { composeDayPendingSlots, type PendingSlot } from "@/lib/bookings/pending";
import { getDayBookings, getPendingBookings } from "@/lib/bookings/queries";
import { composeDayBookingSections, NO_HORSE, type DayBookingSections } from "@/lib/bookings/rows";
import { PENDING_BOOKINGS_ROUTE } from "@/lib/auth/roles";
import { stableBookingSuccessMessage } from "@/lib/bookings/stable-redirect";
import { formatWaitingCount } from "@/lib/bookings/waiting";
import { formatClockHour, formatFreeSeats, formatLongDateWithYear } from "@/lib/format";
import { addDays, parseScheduleDate, todayIso } from "@/lib/schedule/dates";
import { SLOT_KIND, TRAINING_SLOT_TAG } from "@/lib/schedule/kind";
import { getScheduleDay, type ScheduleDayData } from "@/lib/schedule/queries";
import { listStablePlaces } from "@/lib/places/queries";
import { getOwnedStableId, listStableHorses } from "@/lib/stables/queries";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles). Przydział konia działa także
// w dniach minionych (uzupełnienie statystyk); odwołanie — tylko przed terminem jazdy:
// próg pilnuje endpoint, a strona chowa akcję przy zapisach, które się zaczęły.
// Zapisy oczekujące dnia (#128) stoją nad aktywnymi, wyróżnione, przy swoich slotach — z tymi samymi
// „Przyjmij” i „Odrzuć” co na „Zapisach do przyjęcia” (decyzja wraca na ten dzień). Jeźdźca zapisu
// oczekującego (imię, e-mail) daje ta sama funkcja bazy co „Zapisom do przyjęcia” — RLS profili go nie odda.
const { profile } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("sukces");

// Domyślnie dziś, nie jutro jak grafik: operacyjne pytanie ośrodka przy odczycie
// to "kto dziś jeździ", a przy układaniu - "co ustawić na jutro".
const day = parseScheduleDate(Astro.url.searchParams.get("dzien")) ?? todayIso();

const supabase = createClient(Astro.request.headers, Astro.cookies);

let scheduleDay: ScheduleDayData | null = null;
let sections: DayBookingSections = { active: [], cancelled: [] };
let pendingSlots: PendingSlot[] = [];
let loadFailed = false;

if (supabase && profile) {
  try {
    const stableId = await getOwnedStableId(supabase, profile.id);
    if (stableId !== null) {
      scheduleDay = await getScheduleDay(supabase, stableId, day);
      if (scheduleDay) {
        const [bookings, horses, places, boarding, pending] = await Promise.all([
          getDayBookings(supabase, scheduleDay.id),
          listStableHorses(supabase, stableId),
          listStablePlaces(supabase, stableId),
          listBoardingHorses(supabase, { stableId }),
          getPendingBookings(supabase),
        ]);
        pendingSlots = composeDayPendingSlots(pending, day);
        sections = composeDayBookingSections({
          bookings,
          horses,
          dayHorseIds: scheduleDay.horseIds,
          slots: scheduleDay.seats,
          places,
          // Konie pensjonariuszy z pobytami — do wyboru przy slotach treningowych (#115).
          boardingHorses: boarding,
          day,
        });
      }
    }
  } catch (error) {
    loadFailed = true;
    logError("page:osrodek/zapisy", error);
  }
} else {
  // Brak klienta Supabase lub profilu to awaria konfiguracji, nie pusty dzień.
  loadFailed = true;
}

const dayLabel = formatLongDateWithYear(day);

const successMessage = stableBookingSuccessMessage(success);
---

<Layout title={`Zapisy ${day}`}>
  <Topbar />
  <main class="container-narrow page">
    <h1>Zapisy dnia</h1>
    <p class="page-lead">Kto u którego instruktora jeździ wybranego dnia. Tu przydzielasz konie i odwołujesz zapisy.</p>

    <DayNav>
      <a slot="prev" href={`/osrodek/zapisy?dzien=${addDays(day, -1)}`}>
        <ChevronLeft className="size-4" />
        Poprzedni
      </a>
      <Fragment slot="date">{dayLabel}</Fragment>
      <a slot="next" href={`/osrodek/zapisy?dzien=${addDays(day, 1)}`}>
        Następny
        <ChevronRight className="size-4" />
      </a>
    </DayNav>

    {
      successMessage && (
        <div class="notice">
          <Banner variant="success">{successMessage}</Banner>
        </div>
      )
    }
    {
      error && (
        <div class="notice">
          <Banner variant="error">{error}</Banner>
        </div>
      )
    }

    {
      loadFailed ? (
        <FailureState>
          <p>Nie udało się wczytać zapisów.</p>
          <p>Odśwież stronę za chwilę.</p>
        </FailureState>
      ) : !scheduleDay ? (
        <Card>
          <EmptyState>
            <p>Ten dzień nie ma ułożonego grafiku.</p>
            <a href={`/osrodek/grafik?dzien=${day}`}>Przejdź do grafiku dnia</a>
          </EmptyState>
        </Card>
      ) : (
        <>
          {pendingSlots.length > 0 && (
            <section class="section" aria-labelledby="pending-heading">
              <Card class="pending-card">
                <h2 id="pending-heading">Czekają na przyjęcie</h2>
                <p class="section-lead">
                  Zapis oczekujący nie zajmuje miejsca, dopóki go nie przyjmiesz.{" "}
                  <a href={PENDING_BOOKINGS_ROUTE}>Wszystkie zapisy do przyjęcia</a>
                </p>
                <ul class="slots">
                  {pendingSlots.map((slot) => (
                    <li class="pending-slot">
                      <div class="pending-slot__head">
                        <span class="row__when">{formatClockHour(slot.hour)}</span>
                        <span class="row__meta">
                          <span class="row__strong">{slot.instructorName}</span>
                          <span class="row__sub">{slot.placeName}</span>
                          {slot.kind === SLOT_KIND.training && <Tag variant="primary">{TRAINING_SLOT_TAG}</Tag>}
                          {slot.freeSeats === 0 ? (
                            <Tag variant="warn">Brak miejsc</Tag>
                          ) : (
                            <span class="row__sub mono-nums">{formatFreeSeats(slot.freeSeats, slot.seats)}</span>
                          )}
                          <Tag variant="warn">{formatWaitingCount(slot.waiting)}</Tag>
                        </span>
                      </div>
                      <ul class="rows">
                        {slot.rows.map((row) => (
                          <li data-pending-booking={row.id}>
                            <span class="row__meta">
                              <span class="row__strong">{row.riderName}</span>
                              {row.riderEmail && <span class="row__sub">{row.riderEmail}</span>}
                              {row.rejectedBefore && <Tag>wcześniej odrzucony na ten slot</Tag>}
                            </span>
                            <div class="row__actions">
                              <form method="post" action="/api/bookings/accept">
                                <input type="hidden" name="bookingId" value={row.id} />
                                <input type="hidden" name="day" value={day} />
                                <GhostButton>
                                  <Check className="size-4" aria-hidden="true" />
                                  Przyjmij
                                </GhostButton>
                              </form>
                              <RejectBookingForm bookingId={row.id} riderName={row.riderName} day={day} />
                            </div>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </Card>
            </section>
          )}

          <section class="section" aria-labelledby="active-heading">
            <Card>
              <h2 id="active-heading">Aktywne</h2>
              {sections.active.length === 0 ? (
                <EmptyState>
                  <p>Brak zapisów tego dnia.</p>
                  <p>
                    Grafik jest ułożony ({scheduleDay.openHour}–{scheduleDay.closeHour}), ale nikt nie jest zapisany.
                  </p>
                </EmptyState>
              ) : (
                <ul class="rows">
                  {sections.active.map((row) => (
                    <li>
                      {/* Cały tekst tego elementu to sama godzina. */}
                      <span class="row__when">{formatClockHour(row.hour)}</span>
                      <span class="row__meta">
                        <span class="row__strong">{row.instructorName}</span>
                        {row.placeName && <span class="row__sub">{row.placeName}</span>}
                        {row.kind === SLOT_KIND.training && <Tag variant="primary">{TRAINING_SLOT_TAG}</Tag>}
                        <span class="row__sub">{row.riderName}</span>
                        {/* Zapis bez konia jest wyróżniony pigułką (US 48). */}
                        {row.horseId === null ? (
                          <Tag variant="warn">{row.horseName}</Tag>
                        ) : (
                          <span class="row__sub">{row.horseName}</span>
                        )}
                      </span>
                      <div class="row__actions">
                        <form method="post" action="/api/bookings/assign-horse" class="assign">
                          <input type="hidden" name="bookingId" value={row.id} />
                          <input type="hidden" name="day" value={day} />
                          <label for={`horse-${String(row.id)}`}>Koń</label>
                          <select id={`horse-${String(row.id)}`} name="horseId">
                            {row.noHorseChoice && (
                              <option value="" selected={row.horseId === null}>
                                {NO_HORSE}
                              </option>
                            )}
                            {row.horseOptions.map((horse) => (
                              <option value={horse.id} selected={horse.id === row.horseId}>
                                {horse.name}
                              </option>
                            ))}
                          </select>
                          <GhostButton>Zapisz konia</GhostButton>
                        </form>
                        {row.cancellable && (
                          /* Jeden krok potwierdzenia bez JavaScriptu (US 83): odwołania nie da się cofnąć. */
                          <details class="cancel">
                            <summary>
                              <CalendarX2 className="size-4" />
                              Odwołaj zapis
                            </summary>
                            <form method="post" action="/api/bookings/stable-cancel" class="cancel__confirm">
                              <input type="hidden" name="bookingId" value={row.id} />
                              <input type="hidden" name="day" value={day} />
                              <p>
                                Odwołać zapis: {row.riderName}, {formatClockHour(row.hour)} u {row.instructorName}? Tego
                                nie da się cofnąć.
                              </p>
                              <button type="submit" class="btn-danger">
                                Potwierdź odwołanie
                              </button>
                            </form>
                          </details>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </Card>
          </section>

          {sections.cancelled.length > 0 && (
            <section class="section" aria-labelledby="cancelled-heading">
              <Card>
                <h2 id="cancelled-heading" class="muted-heading">
                  Odwołane
                </h2>
                <ul class="rows rows--cancelled">
                  {sections.cancelled.map((row) => (
                    <li>
                      <span class="row__when">{formatClockHour(row.hour)}</span>
                      <span class="row__meta">
                        <span class="row__strong">{row.instructorName}</span>
                        <span class="row__sub">{row.riderName}</span>
                        {/* Cały tekst tego elementu to samo słowo — jak w „Moje zapisy". */}
                        <Tag>odwołany</Tag>
                        <span class="row__sub">{row.cancelledByLabel}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </Card>
            </section>
          )}
        </>
      )
    }
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  h1 {
    font-size: 32px;
  }
  .page-lead {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }
  .notice {
    margin-top: 16px;
  }
  .section {
    display: block;
    margin-top: 18px;
  }
  h2 {
    font-size: 22px;
    margin: 0 0 14px;
  }
  .muted-heading {
    color: var(--muted);
  }

  /* Zapisy oczekujące są wyróżnione (#128): obrys i pasek w kolorze uwagi, sloty jeden pod drugim. */
  .section :global(.pending-card) {
    border-color: var(--warn);
    border-left-width: 5px;
  }
  .section-lead {
    margin: -6px 0 14px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .section-lead a {
    color: var(--primary-strong);
    font-weight: 600;
  }
  .slots {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .pending-slot {
    padding: 12px 14px;
    border-radius: var(--r);
    background: var(--surface-2);
  }
  .pending-slot__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin-bottom: 10px;
  }

  /* Ten sam wzorzec wiersza co „Moje zapisy". */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows > li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }
  .rows > li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .rows > li:last-child {
    padding-bottom: 0;
  }
  .row__when {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  .row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    min-width: 0;
  }
  .row__strong {
    font-weight: 600;
  }
  /* Adres e-mail jeźdźca musi się łamać, a nie rozpychać wiersza w bok. */
  .row__sub {
    color: var(--muted);
    font-size: 14.5px;
    overflow-wrap: anywhere;
  }
  .rows--cancelled .row__when,
  .rows--cancelled .row__strong {
    font-weight: 500;
    color: var(--muted);
  }

  /* Akcje schodzą pod opis na całą szerokość — na telefonie nie mieszczą się obok. */
  .row__actions {
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 10px 16px;
  }
  .assign {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .assign label {
    font-size: 13px;
    font-weight: 600;
  }
  .assign select {
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--border-2);
    border-radius: 12px;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: 14.5px;
  }
  .assign select:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .btn-danger,
  .cancel summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 15px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .cancel summary {
    list-style: none;
    border: 1px solid var(--danger);
    background: var(--surface);
    color: var(--danger-ink);
  }
  .cancel summary::-webkit-details-marker {
    display: none;
  }
  .cancel summary:hover {
    background: var(--danger-soft);
  }
  /* `[open]` ustawia przeglądarka — analiza selektorów Astro go nie widzi. */
  .cancel:global([open]) summary {
    background: var(--danger-soft);
  }
  .cancel summary:focus-visible,
  .btn-danger:focus-visible {
    outline: 2px solid var(--danger);
    outline-offset: 2px;
  }
  .cancel__confirm {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .cancel__confirm p {
    margin: 0;
    font-size: 14.5px;
    max-width: 52ch;
  }
  .btn-danger {
    border: 1px solid var(--danger);
    background: var(--danger);
    color: var(--surface);
  }
  .btn-danger:hover {
    background: var(--danger-ink);
  }
</style>
