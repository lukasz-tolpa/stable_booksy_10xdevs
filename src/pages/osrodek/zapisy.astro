---
import { ChevronLeft, ChevronRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import Card from "@/components/ui/Card.astro";
import DayNav from "@/components/ui/DayNav.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import { getDayBookings } from "@/lib/bookings/queries";
import { composeBookingRows, type BookingRow } from "@/lib/bookings/rows";
import { addDays, parseScheduleDate, todayIso } from "@/lib/schedule/dates";
import { getScheduleDay, type ScheduleDayData } from "@/lib/schedule/queries";
import { getOwnedStableId, listStableHorses } from "@/lib/stables/queries";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles). Strona jest czysto
// odczytowa - dni przeszłe są dozwolone bez żadnego guardu, bo nie ma tu akcji,
// które ograniczenie grafiku ("dziś i w przód") chroniło.
const { profile } = Astro.locals;

// Domyślnie dziś, nie jutro jak grafik: operacyjne pytanie ośrodka przy odczycie
// to "kto dziś jeździ", a przy układaniu - "co ustawić na jutro".
const day = parseScheduleDate(Astro.url.searchParams.get("dzien")) ?? todayIso();

const supabase = createClient(Astro.request.headers, Astro.cookies);

let scheduleDay: ScheduleDayData | null = null;
let rows: BookingRow[] = [];
let loadFailed = false;

if (supabase && profile) {
  try {
    const stableId = await getOwnedStableId(supabase, profile.id);
    if (stableId !== null) {
      scheduleDay = await getScheduleDay(supabase, stableId, day);
      if (scheduleDay) {
        const [bookings, horses] = await Promise.all([
          getDayBookings(supabase, scheduleDay.id),
          listStableHorses(supabase, stableId),
        ]);
        rows = composeBookingRows(bookings, horses);
      }
    }
  } catch (error) {
    loadFailed = true;
    logError("page:osrodek/zapisy", error);
  }
} else {
  // Brak klienta Supabase lub profilu to awaria konfiguracji, nie pusty dzień.
  loadFailed = true;
}

const dayLabel = new Date(`${day}T00:00:00`).toLocaleDateString("pl-PL", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout title={`Zapisy ${day}`}>
  <Topbar />
  <main class="container-narrow page">
    <h1>Zapisy dnia</h1>
    <p class="page-lead">Kto i na którym koniu jeździ wybranego dnia.</p>

    <DayNav>
      <a slot="prev" href={`/osrodek/zapisy?dzien=${addDays(day, -1)}`}>
        <ChevronLeft className="size-4" />
        Poprzedni
      </a>
      <Fragment slot="date">{dayLabel}</Fragment>
      <a slot="next" href={`/osrodek/zapisy?dzien=${addDays(day, 1)}`}>
        Następny
        <ChevronRight className="size-4" />
      </a>
    </DayNav>

    {
      loadFailed ? (
        <FailureState>
          <p>Nie udało się wczytać zapisów.</p>
          <p>Odśwież stronę za chwilę.</p>
        </FailureState>
      ) : !scheduleDay ? (
        <Card>
          <EmptyState>
            <p>Ten dzień nie ma ułożonego grafiku.</p>
            <a href={`/osrodek/grafik?dzien=${day}`}>Przejdź do grafiku dnia</a>
          </EmptyState>
        </Card>
      ) : rows.length === 0 ? (
        <Card>
          <EmptyState>
            <p>Brak zapisów tego dnia.</p>
            <p>
              Grafik jest ułożony ({scheduleDay.openHour}–{scheduleDay.closeHour}), ale nikt się jeszcze nie zapisał.
            </p>
          </EmptyState>
        </Card>
      ) : (
        <Card>
          <ul class="rows">
            {rows.map((row) => (
              <li>
                {/* Cały tekst tego elementu to sama godzina. */}
                <span class="row__when">{row.hour}:00</span>
                <span class="row__meta">
                  <span class="row__horse">{row.horseName}</span>
                  <span class="row__sub">{row.riderName}</span>
                </span>
              </li>
            ))}
          </ul>
        </Card>
      )
    }
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  h1 {
    font-size: 32px;
  }
  .page-lead {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }

  /* Ten sam wzorzec wiersza co „Moje zapisy" - bez kolumny akcji. */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows > li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }
  .rows > li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .rows > li:last-child {
    padding-bottom: 0;
  }
  .row__when {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  .row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    min-width: 0;
  }
  .row__horse {
    font-weight: 600;
  }
  /* Adres e-mail jeźdźca musi się łamać, a nie rozpychać wiersza w bok. */
  .row__sub {
    color: var(--muted);
    font-size: 14.5px;
    overflow-wrap: anywhere;
  }
</style>
