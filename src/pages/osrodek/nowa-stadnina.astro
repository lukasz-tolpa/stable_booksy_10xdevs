---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import NewStableForm from "@/components/stable/NewStableForm";
import Card from "@/components/ui/Card.astro";

// Middleware kieruje tutaj każde konto ośrodka, które nie ma jeszcze stadniny,
// i zawraca stąd te, które już ją mają.
const error = Astro.url.searchParams.get("error");
---

<Layout title="Załóż stadninę">
  <Topbar />
  <div class="container-narrow wrap">
    <Card class="w-full max-w-[460px]" padding={28}>
      <p class="eyebrow">Stadnina</p>
      <h1>Załóż stadninę</h1>
      <p class="lead">
        Zanim ułożysz grafik i przyjmiesz pierwsze zapisy, powiedz nam, jak nazywa się Twoja stadnina i gdzie się
        znajduje. Bez tego jeźdźcy nie znajdą Cię na liście ośrodków.
      </p>
      <NewStableForm serverError={error} client:load />
    </Card>
  </div>
</Layout>

<style>
  .wrap {
    display: flex;
    justify-content: center;
    padding-block: 36px 56px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--primary);
    font-weight: 500;
    margin: 0;
  }
  h1 {
    font-size: 26px;
    margin: 0 0 4px;
  }
  .lead {
    font-size: 14.5px;
    color: var(--muted);
    margin: 0 0 22px;
  }
</style>
