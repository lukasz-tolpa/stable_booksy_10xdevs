---
import { PawPrint } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import HorseForm from "@/components/stables/HorseForm";
import Card from "@/components/ui/Card.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import { getOwnedStableId, listStableHorses, type HorseListItem } from "@/lib/stables/queries";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles), a konto ośrodka ma
// gwarantowaną stadninę dzięki wymuszeniu z S-01 - stąd brak gałęzi "brak stadniny".
const { profile } = Astro.locals;
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);

let horses: HorseListItem[] = [];
let loadFailed = false;

if (supabase && profile) {
  try {
    const stableId = await getOwnedStableId(supabase, profile.id);
    horses = stableId === null ? [] : await listStableHorses(supabase, stableId);
  } catch (error) {
    loadFailed = true;
    logError("page:osrodek/konie", error);
  }
}

const active = horses.filter((horse) => horse.active);
const retired = horses.filter((horse) => !horse.active);
---

<Layout title="Konie">
  <Topbar />
  <main class="container-narrow page">
    <h1>Konie</h1>
    <p class="page-lead">Stado Twojej stadniny. Z tej listy wybierasz konie pracujące w danym dniu.</p>

    <div class="cols">
      <div class="herd">
        {
          loadFailed ? (
            <FailureState>
              <p>Nie udało się wczytać stada.</p>
              <p>Odśwież stronę za chwilę.</p>
            </FailureState>
          ) : horses.length === 0 ? (
            <Card>
              <EmptyState>
                <p>
                  Nie masz jeszcze żadnych koni. Dodaj pierwszego konia — bez tego nie da się ułożyć grafiku dnia, bo
                  nie będzie czego przydzielić do godzin.
                </p>
              </EmptyState>
            </Card>
          ) : (
            <>
              {active.map((horse) => (
                <Card padding={18}>
                  <article class="horse">
                    <div class="horse__body">
                      <h2>
                        <PawPrint className="size-4" />
                        {horse.name}
                      </h2>
                      {horse.notes && <p class="horse__notes">{horse.notes}</p>}
                    </div>
                    <form method="POST" action="/api/horses/toggle-active">
                      <input type="hidden" name="horseId" value={horse.id} />
                      <input type="hidden" name="active" value="false" />
                      <button type="submit">Wycofaj ze służby</button>
                    </form>
                  </article>
                </Card>
              ))}

              {retired.length > 0 && (
                <>
                  <h2 class="retired-head">Wycofane ze służby</h2>
                  {retired.map((horse) => (
                    <Card padding={18} class="opacity-70">
                      <article class="horse">
                        <div class="horse__body">
                          <h3>
                            <PawPrint className="size-4" />
                            {horse.name}
                          </h3>
                          {horse.notes && <p class="horse__notes">{horse.notes}</p>}
                        </div>
                        <form method="POST" action="/api/horses/toggle-active">
                          <input type="hidden" name="horseId" value={horse.id} />
                          <input type="hidden" name="active" value="true" />
                          <button type="submit">Przywróć</button>
                        </form>
                      </article>
                    </Card>
                  ))}
                </>
              )}
            </>
          )
        }
      </div>

      <Card>
        <h2 class="form-head">Dodaj konia</h2>
        <HorseForm serverError={error} client:load />
      </Card>
    </div>
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  h1 {
    font-size: 32px;
  }
  .page-lead {
    margin: 10px 0 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }

  .cols {
    margin-top: 24px;
    display: grid;
    gap: 22px;
    align-items: start;
  }
  @media (width >= 900px) {
    .cols {
      grid-template-columns: 1fr 20rem;
    }
  }

  .herd {
    display: grid;
    gap: 12px;
  }

  .horse {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .horse__body {
    min-width: 0;
  }
  .horse h2,
  .horse h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    margin: 0;
  }
  .horse__notes {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .horse button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    background: var(--surface);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--fg);
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .horse button:hover {
    background: var(--surface-2);
  }
  .horse button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .retired-head {
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
  }

  .form-head {
    font-size: 17px;
    margin: 0 0 14px;
  }
</style>
