---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import PanelLastMonth from "@/components/stable-panel/PanelLastMonth.astro";
import PanelSide from "@/components/stable-panel/PanelSide.astro";
import PanelWeek from "@/components/stable-panel/PanelWeek.astro";
import { listInstructorAccounts, listStableInstructors } from "@/lib/instructors/queries";
import { logError } from "@/lib/log";
import { todayIso } from "@/lib/schedule/dates";
import {
  composeLastMonth,
  composeSideColumn,
  composeWeek,
  historyPeriod,
  weekPeriod,
  type LastMonthView,
  type WeekView,
} from "@/lib/stable-panel/panel";
import { PANEL_TEXTS } from "@/lib/stable-panel/texts";
import { getOwnedStable, listStableHorses, type OwnedStable } from "@/lib/stables/queries";
import { getStatsRows } from "@/lib/stats/queries";
import type { StatsBooking } from "@/lib/stats/stats";
import { createClient } from "@/lib/supabase";

// Panel ośrodka (spec #83). Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles) — strona
// nie powtarza sprawdzenia roli. Każda część (tydzień, 30 dni, boczna kolumna) wczytuje się osobno:
// awaria jednej daje jej `FailureState`, reszta się wyświetla. Liczy `@/lib/stable-panel/panel`;
// tu tylko odczyt i render. Kolejna część dochodzi jako następne zadanie w `Promise.allSettled`
// i następny komponent w kolumnie `.main`.
const { profile } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const now = new Date();
const today = todayIso(now);
const SCOPE = "page:osrodek";

let stable: OwnedStable | null = null;
let week: WeekView | null = null;
let lastMonth: LastMonthView | null = null;
let sideData: Awaited<ReturnType<typeof loadSideData>> | null = null;
let monthBookings: StatsBooking[] | null = null;

type Client = NonNullable<typeof supabase>;
type Horses = ReturnType<typeof listStableHorses>;

function loadSideData(client: Client, stableId: number, horses: Horses) {
  return Promise.all([horses, listStableInstructors(client, stableId), listInstructorAccounts(client)]);
}

/** Wartość udanej części albo `null` — awaria jednej części trafia do logu, reszta się wyświetla. */
function settledValue<T>(result: PromiseSettledResult<T>): T | null {
  if (result.status === "fulfilled") {
    return result.value;
  }
  logError(SCOPE, result.reason);
  return null;
}

// Jeden odczyt minionych wierszy dla 30 dni i dla jazd bieżącego miesiąca w bocznej kolumnie.
async function loadHistory(client: Client, stableId: number, horses: Horses) {
  const [rows, stableHorses] = await Promise.all([getStatsRows(client, stableId, historyPeriod(today)), horses]);
  return { lastMonth: composeLastMonth({ today, ...rows, horses: stableHorses }, now), bookings: rows.bookings };
}

if (supabase && profile) {
  try {
    stable = await getOwnedStable(supabase, profile.id);
    if (stable === null) {
      // Middleware nie wpuszcza tu właściciela bez stadniny; jej brak to awaria odczytu.
      logError(SCOPE, new Error("Brak stadniny dla konta właściciela"));
    }
  } catch (error) {
    logError(SCOPE, error);
  }

  if (stable) {
    const stableId = stable.id;
    // Stado czytają dwie części (liczba aktywnych koni, nazwy koni w 30 dniach) — jeden odczyt.
    const horses = listStableHorses(supabase, stableId);
    const [weekResult, historyResult, sideResult] = await Promise.allSettled([
      getStatsRows(supabase, stableId, weekPeriod(today)).then((rows) => composeWeek({ today, ...rows })),
      loadHistory(supabase, stableId, horses),
      loadSideData(supabase, stableId, horses),
    ]);

    week = settledValue(weekResult);
    const history = settledValue(historyResult);
    lastMonth = history?.lastMonth ?? null;
    monthBookings = history?.bookings ?? null;
    sideData = settledValue(sideResult);
  }
}

const [horses, instructors, accounts] = sideData ?? [null, null, null];
const sideLinks = composeSideColumn({ today, week, horses, instructors, accounts, monthBookings }, now);
---

<Layout title={PANEL_TEXTS.heading}>
  <Topbar container="page" />
  <main class="container-page page">
    <div class="layout">
      <div class="main">
        <h1>{PANEL_TEXTS.heading}</h1>
        {
          stable ? (
            <p class="stable">
              <span class="stable__name">{stable.name}</span>
              <span class="stable__city"> &middot; {stable.city}</span>
            </p>
          ) : (
            <p class="stable stable--failed">{PANEL_TEXTS.stableFailure}</p>
          )
        }
        <PanelWeek week={week} />
        <PanelLastMonth month={lastMonth} />
      </div>
      <PanelSide links={sideLinks} failed={sideData === null} />
    </div>
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  .layout {
    display: grid;
    gap: 28px;
  }
  @media (width >= 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 260px;
      align-items: start;
    }
  }
  .main {
    min-width: 0;
  }
  h1 {
    font-size: 30px;
    margin: 0;
  }
  .stable {
    margin: 6px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  .stable--failed {
    font-weight: 600;
    color: var(--warn-ink);
  }
  .stable__name {
    font-weight: 600;
    color: var(--fg);
  }
</style>
