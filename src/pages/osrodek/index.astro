---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import Card from "@/components/ui/Card.astro";
import { createClient } from "@/lib/supabase";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles) - strona nie powtarza
// sprawdzenia roli. Treść merytoryczną grafiku dołoży S-02.
const { profile } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
// Filtr po właścicielu jest konieczny: polityka odczytu na `stables` pokazuje katalog
// wszystkim zalogowanym, więc bez niego zapytanie zwróciłoby także cudze stadniny.
const { data: stable } = supabase
  ? await supabase
      .from("stables")
      .select("name, city")
      .eq("owner_id", profile?.id ?? "")
      .maybeSingle()
  : { data: null };
---

<Layout title="Panel ośrodka">
  <Topbar />
  <main class="container-narrow page">
    <Card>
      <h1>Panel ośrodka</h1>
      {
        stable ? (
          <p class="stable">
            <span class="stable__name">{stable.name}</span>
            <span class="stable__city"> &middot; {stable.city}</span>
          </p>
        ) : (
          <p class="stable">Twoje konto nie ma jeszcze przypisanej stadniny.</p>
        )
      }

      <nav class="links">
        <a href="/osrodek/grafik">Grafik dnia</a>
        <a href="/osrodek/konie">Konie</a>
        <a href="/osrodek/zapisy">Zapisy</a>
      </nav>
    </Card>
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  h1 {
    font-size: 30px;
    margin: 0;
  }
  .stable {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
  }
  .stable__name {
    font-weight: 600;
    color: var(--fg);
  }

  .links {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    background: var(--surface);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    color: var(--fg);
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .links a:hover {
    background: var(--primary-soft);
    border-color: var(--primary);
    color: var(--primary-strong);
  }
  .links a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>
