---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles) - strona nie powtarza
// sprawdzenia roli. Treść merytoryczną grafiku dołoży S-02.
const { profile } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
// Filtr po właścicielu jest konieczny: polityka odczytu na `stables` pokazuje katalog
// wszystkim zalogowanym, więc bez niego zapytanie zwróciłoby także cudze stadniny.
const { data: stable } = supabase
  ? await supabase
      .from("stables")
      .select("name, city")
      .eq("owner_id", profile?.id ?? "")
      .maybeSingle()
  : { data: null };
---

<Layout title="Panel ośrodka">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-3xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Panel ośrodka
        </h1>
        {
          stable ? (
            <p class="text-blue-100/80">
              <span class="font-semibold text-white">{stable.name}</span>
              <span class="text-blue-100/60"> &middot; {stable.city}</span>
            </p>
          ) : (
            <p class="text-blue-100/80">Twoje konto nie ma jeszcze przypisanej stadniny.</p>
          )
        }
      </div>
    </div>
  </div>
</Layout>
