---
import Banner from "@/components/Banner.astro";
import AddCost from "@/components/settlements/AddCost.astro";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import MonthNav from "@/components/month-summary/MonthNav.astro";
import SettlementRows from "@/components/settlements/SettlementRows.astro";
import StableRate from "@/components/settlements/StableRate.astro";
import Card from "@/components/ui/Card.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import { logError } from "@/lib/log";
import { MONTH_PARAM, resolveSummaryMonth } from "@/lib/month-summary/month";
import { composeMonthNav } from "@/lib/month-summary/summary";
import { todayIso } from "@/lib/schedule/dates";
import { composeAddCost, type AddCostView } from "@/lib/settlements/costs";
import { listStableRiders, loadSettlementsInput } from "@/lib/settlements/queries";
import { riderSettlementHref, settlementsHref } from "@/lib/settlements/redirect";
import { composeSettlementsPage, type SettlementsView } from "@/lib/settlements/settlements";
import { SETTLEMENT_TEXTS } from "@/lib/settlements/texts";
import { getOwnedStableId } from "@/lib/stables/queries";
import { createClient } from "@/lib/supabase";
// PROTOTYPE — warianty układu strony (?variant=), tylko w trybie deweloperskim. Throwaway, gałąź prototype/rozliczenia-ux.
import PrototypeSwitcher from "@/components/prototype/PrototypeSwitcher.astro";
import VariantA from "@/components/prototype/rozliczenia/VariantA.astro";
import VariantB from "@/components/prototype/rozliczenia/VariantB.astro";
import VariantC from "@/components/prototype/rozliczenia/VariantC.astro";

// Rozliczenia właściciela (#94, spec #93). Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles):
// przestrzeń ośrodka jest tylko dla właściciela; stawki chroni dodatkowo RLS. Liczy
// `@/lib/settlements/settlements`; tu tylko odczyt i render. Miesiąc żyje w adresie (`?miesiac=RRRR-MM`),
// formularze stawki i „Dopisz koszt” (#96) wracają na niego z `?sukces=1` albo `?error=`.
const { profile } = Astro.locals;
const SCOPE = "page:osrodek/rozliczenia";
const texts = SETTLEMENT_TEXTS;
const now = new Date();
const month = resolveSummaryMonth(Astro.url.searchParams.get(MONTH_PARAM), todayIso(now));
const error = Astro.url.searchParams.get("error");
const saved = Astro.url.searchParams.get("sukces") === "1";

// PROTOTYPE: trzy układy + dzisiejszy („0”) do porównania; linki miesięcy zachowują wariant.
const PROTO_VARIANTS = [
  { key: "0", name: "Obecny" },
  { key: "A", name: "Arkusz miesiąca" },
  { key: "B", name: "Kolumna boczna" },
  { key: "C", name: "Najpierw kwota" },
];
const protoVariant = import.meta.env.DEV ? (Astro.url.searchParams.get("variant") ?? "A") : "0";
const monthLink = (m: string) =>
  protoVariant === "0" ? settlementsHref(m) : `${settlementsHref(m)}&variant=${protoVariant}`;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let view: SettlementsView | null = null;
let addCost: AddCostView | null = null;

if (supabase && profile) {
  try {
    const stableId = await getOwnedStableId(supabase, profile.id);
    if (stableId === null) {
      // Middleware nie wpuszcza tu właściciela bez stadniny; jej brak to awaria odczytu, nie pusty miesiąc.
      logError(SCOPE, new Error("Brak stadniny dla konta właściciela"));
    } else {
      // Ten sam odczyt zapisów miesiąca co Podsumowanie miesiąca właściciela, bez filtra instruktora,
      // plus stawki i koszty dodatkowe miesiąca (`loadSettlementsInput`, jak suma w panelu ośrodka).
      const [input, riders] = await Promise.all([
        loadSettlementsInput(supabase, stableId, month),
        listStableRiders(supabase),
      ]);
      addCost = composeAddCost(riders, month.month);
      view = composeSettlementsPage(
        {
          ...input,
          monthHref: monthLink,
          riderHref: (riderKey) => riderSettlementHref(riderKey, month.month),
        },
        now,
      );
    }
  } catch (error) {
    logError(SCOPE, error);
  }
} else {
  // Brak klienta Supabase lub profilu to awaria konfiguracji, nie pusty miesiąc.
  logError(SCOPE, new Error("Brak klienta Supabase albo profilu właściciela"));
}

// Przełącznik miesięcy zostaje także przy awarii odczytu — da się przejść do innego miesiąca.
const nav = view?.nav ?? composeMonthNav(month, settlementsHref);
---

<Layout title={texts.heading}>
  <Topbar />
  {
    view && protoVariant === "A" && (
      <VariantA view={view} addCost={addCost} month={month.month} saved={saved} error={error} />
    )
  }
  {
    view && protoVariant === "B" && (
      <VariantB view={view} addCost={addCost} month={month.month} saved={saved} error={error} />
    )
  }
  {
    view && protoVariant === "C" && (
      <VariantC view={view} addCost={addCost} month={month.month} saved={saved} error={error} />
    )
  }
  {import.meta.env.DEV && <PrototypeSwitcher variants={PROTO_VARIANTS} current={protoVariant} />}
  {
    (!view || protoVariant === "0") && (
      <main class="container-narrow page">
        <h1>{texts.heading}</h1>
        <p class="lead">{texts.lead}</p>

        {saved && (
          <div class="notice">
            <Banner variant="success">{texts.saved}</Banner>
          </div>
        )}
        {error && (
          <div class="notice">
            <Banner variant="error">{error}</Banner>
          </div>
        )}

        {view && <StableRate rate={view.rate} month={month.month} />}

        <div class="month">
          <MonthNav nav={nav} />
        </div>

        {!view ? (
          <FailureState>
            <p>{texts.failure}</p>
            <p>{texts.retry}</p>
          </FailureState>
        ) : view.isEmpty ? (
          <Card>
            <EmptyState>
              <p>{view.emptyText}</p>
              <p>{texts.emptyHint}</p>
            </EmptyState>
          </Card>
        ) : (
          <section aria-labelledby="riders-heading">
            <h2 id="riders-heading">{texts.ridersHeading}</h2>
            <SettlementRows list={view.list} monthRateText={view.monthRateText} />
          </section>
        )}

        {addCost && <AddCost form={addCost} />}
      </main>
    )
  }
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  h1 {
    font-size: 32px;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 20px;
  }
  .lead {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }
  .notice {
    margin-top: 18px;
  }
  .month {
    margin-top: 18px;
  }
</style>
