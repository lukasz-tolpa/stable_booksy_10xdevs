---
import { UserRound } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import Banner from "@/components/Banner.astro";
import CopyLink from "@/components/instructors/CopyLink";
import InstructorForm from "@/components/instructors/InstructorForm";
import InviteForm from "@/components/instructors/InviteForm";
import Card from "@/components/ui/Card.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import {
  INVITATION_FLASH_COOKIE,
  invitationNotice,
  parseInvitationFlash,
  type InvitationNotice,
} from "@/lib/instructors/invitations";
import { composeInstructorList, type InstructorList } from "@/lib/instructors/list";
import { listLiveInvitations, listOpenSeatRows, listStableInstructors } from "@/lib/instructors/queries";
import { INSTRUCTORS_ROUTE } from "@/lib/instructors/redirect";
import { todayIso } from "@/lib/schedule/dates";
import { getOwnedStableId } from "@/lib/stables/queries";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles); konto ośrodka ma gwarantowaną
// stadninę - stąd brak gałęzi "brak stadniny". Wzorzec: strona koni.
const { profile } = Astro.locals;
const error = Astro.url.searchParams.get("error");

// Link zaproszenia pokazujemy raz, zaraz po wystawieniu (endpoint odkłada token w ciasteczku).
const flash = parseInvitationFlash(Astro.cookies.get(INVITATION_FLASH_COOKIE)?.value);
Astro.cookies.delete(INVITATION_FLASH_COOKIE, { path: INSTRUCTORS_ROUTE });

const supabase = createClient(Astro.request.headers, Astro.cookies);

let list: InstructorList = { active: [], inactive: [] };
let notice: InvitationNotice | null = null;
let loadFailed = false;

if (supabase && profile) {
  try {
    const stableId = await getOwnedStableId(supabase, profile.id);
    if (stableId !== null) {
      const [instructors, openSeatRows, invitations] = await Promise.all([
        listStableInstructors(supabase, stableId),
        listOpenSeatRows(supabase, stableId, todayIso()),
        listLiveInvitations(supabase),
      ]);
      list = composeInstructorList(instructors, openSeatRows, invitations, profile.id);
      notice = invitationNotice(list, flash, Astro.url.origin);
    }
  } catch (error) {
    loadFailed = true;
    logError("page:osrodek/instruktorzy", error);
  }
}

const { active, inactive } = list;
---

<Layout title="Instruktorzy">
  <Topbar />
  <main class="container-narrow page">
    <h1>Instruktorzy</h1>
    <p class="page-lead">
      Osoby prowadzące jazdy w Twoim ośrodku. Jesteś wśród nich jako właściciel i układasz grafik za wszystkich.
      Instruktora bez konta możesz zaprosić — dostaniesz link, który przekażesz mu sam.
    </p>

    {
      error && (
        <div class="notice">
          <Banner variant="error">{error}</Banner>
        </div>
      )
    }

    <div class="cols">
      <div class="list">
        {
          notice && (
            <Card>
              <section class="invitation" aria-labelledby="invitation-heading">
                <h2 id="invitation-heading">Link zaproszenia</h2>
                <p>
                  Dla: <strong>{notice.instructorName}</strong>, adres {notice.email}. {notice.expiresLabel}. Przekaż go
                  instruktorowi SMS-em, komunikatorem albo e-mailem — aplikacja niczego nie wysyła.
                </p>
                <p class="invitation__once">
                  Link widzisz tylko teraz. Jeśli go zgubisz, zaproś instruktora ponownie — poprzedni link przestanie
                  działać.
                </p>
                <CopyLink link={notice.link} client:load />
              </section>
            </Card>
          )
        }

        {
          loadFailed ? (
            <FailureState>
              <p>Nie udało się wczytać instruktorów.</p>
              <p>Odśwież stronę za chwilę.</p>
            </FailureState>
          ) : active.length + inactive.length === 0 ? (
            <Card>
              <EmptyState>
                <p>
                  Nie masz jeszcze żadnych instruktorów. Dodaj pierwszego — prowadzi jazdy, na które zapisują się
                  jeźdźcy.
                </p>
              </EmptyState>
            </Card>
          ) : (
            <>
              {active.map((instructor) => (
                <Card padding={18}>
                  <article class="instructor">
                    <div class="instructor__head">
                      <div class="instructor__text">
                        <h2>
                          <UserRound className="size-4" />
                          {instructor.name}
                        </h2>
                        <p class="instructor__meta">
                          {instructor.owner && <span class="instructor__owner">Właściciel</span>}
                          <span class:list={["account", `account--${instructor.account.kind}`]}>
                            {instructor.account.label}
                          </span>
                          {instructor.account.kind === "invited" && <span>{instructor.account.email}</span>}
                        </p>
                      </div>
                      {!instructor.owner && (
                        <form method="POST" action="/api/instructors/toggle-active">
                          <input type="hidden" name="instructorId" value={instructor.id} />
                          <input type="hidden" name="active" value="false" />
                          <button type="submit">Dezaktywuj</button>
                        </form>
                      )}
                    </div>

                    {instructor.account.kind !== "account" && (
                      <div class="instructor__invite">
                        <details>
                          <summary>{instructor.account.kind === "invited" ? "Zaproś ponownie" : "Zaproś"}</summary>
                          <div class="instructor__invite-form">
                            <InviteForm
                              instructorId={instructor.id}
                              instructorName={instructor.name}
                              defaultEmail={instructor.account.kind === "invited" ? instructor.account.email : ""}
                              client:load
                            />
                          </div>
                        </details>
                        {instructor.account.kind === "invited" && (
                          <form method="POST" action="/api/instructors/revoke-invite">
                            <input type="hidden" name="instructorId" value={instructor.id} />
                            <button type="submit">Wycofaj zaproszenie</button>
                          </form>
                        )}
                      </div>
                    )}
                  </article>
                </Card>
              ))}

              {inactive.length > 0 && (
                <>
                  <h2 class="inactive-head">Nieaktywni</h2>
                  {inactive.map((instructor) => (
                    <Card padding={18} class="opacity-70">
                      <article class="instructor">
                        <div class="instructor__head">
                          <div class="instructor__text">
                            <h3>
                              <UserRound className="size-4" />
                              {instructor.name}
                            </h3>
                            <p class="instructor__meta">
                              <span class:list={["account", `account--${instructor.account.kind}`]}>
                                {instructor.account.label}
                              </span>
                            </p>
                            {instructor.note && <p class="instructor__note">{instructor.note}</p>}
                          </div>
                          <form method="POST" action="/api/instructors/toggle-active">
                            <input type="hidden" name="instructorId" value={instructor.id} />
                            <input type="hidden" name="active" value="true" />
                            <button type="submit">Aktywuj</button>
                          </form>
                        </div>
                      </article>
                    </Card>
                  ))}
                </>
              )}
            </>
          )
        }
      </div>

      <Card>
        <h2 class="form-head">Dodaj instruktora</h2>
        <InstructorForm client:load />
      </Card>
    </div>
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  h1 {
    font-size: 32px;
  }
  .page-lead {
    margin: 10px 0 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }
  .notice {
    margin-top: 18px;
  }

  .cols {
    margin-top: 24px;
    display: grid;
    gap: 22px;
    align-items: start;
  }
  @media (width >= 900px) {
    .cols {
      grid-template-columns: 1fr 20rem;
    }
  }

  .list {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  .invitation h2 {
    font-size: 17px;
    margin: 0;
  }
  .invitation p {
    margin: 8px 0 0;
    font-size: 14px;
    overflow-wrap: anywhere;
  }
  .invitation .invitation__once {
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 13px;
  }

  .instructor__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .instructor h2,
  .instructor h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 17px;
    margin: 0;
  }
  .instructor__text {
    min-width: 0;
  }
  .instructor__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .instructor__owner {
    font-weight: 600;
    color: var(--fg);
  }
  .account--account {
    color: var(--primary-strong);
    font-weight: 600;
  }
  .account--invited {
    color: var(--fg);
  }
  .instructor__note {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .instructor :global(svg) {
    flex-shrink: 0;
  }
  .instructor button,
  .instructor summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    background: var(--surface);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--fg);
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .instructor summary {
    list-style: none;
  }
  .instructor summary::-webkit-details-marker {
    display: none;
  }
  .instructor button:hover,
  .instructor summary:hover {
    background: var(--surface-2);
  }
  .instructor button:focus-visible,
  .instructor summary:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .instructor :global(details[open]) summary {
    background: var(--primary-soft);
    border-color: var(--primary-tint);
  }

  .instructor__invite {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 10px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .instructor__invite :global(details[open]) {
    flex-basis: 100%;
  }
  .instructor__invite-form {
    margin-top: 12px;
  }

  .inactive-head {
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
  }

  .form-head {
    font-size: 17px;
    margin: 0 0 14px;
  }
</style>
