---
import { ChevronLeft, ChevronRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import Card from "@/components/ui/Card.astro";
import DayNav from "@/components/ui/DayNav.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import ScheduleDayForm from "@/components/schedule/ScheduleDayForm";
import { addDays, defaultScheduleDate, isPastDate, parseScheduleDate } from "@/lib/schedule/dates";
import { getLatestScheduleDay, getScheduleDay, type ScheduleDayData } from "@/lib/schedule/queries";
import { getOwnedStableId, listStableHorses, type HorseListItem } from "@/lib/stables/queries";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles). Konto ośrodka ma
// gwarantowaną stadninę dzięki wymuszeniu z S-01.
const { profile } = Astro.locals;
const error = Astro.url.searchParams.get("error");

const day = parseScheduleDate(Astro.url.searchParams.get("dzien")) ?? defaultScheduleDate();
const readOnly = isPastDate(day);

const supabase = createClient(Astro.request.headers, Astro.cookies);

let scheduleDay: ScheduleDayData | null = null;
let latestDay: ScheduleDayData | null = null;
let horses: HorseListItem[] = [];
let loadFailed = false;

if (supabase && profile) {
  try {
    const stableId = await getOwnedStableId(supabase, profile.id);
    if (stableId !== null) {
      [scheduleDay, latestDay, horses] = await Promise.all([
        getScheduleDay(supabase, stableId, day),
        getLatestScheduleDay(supabase, stableId),
        listStableHorses(supabase, stableId),
      ]);
    }
  } catch (error) {
    loadFailed = true;
    logError("page:osrodek/grafik", error);
  }
} else {
  // Brak klienta Supabase lub profilu to awaria konfiguracji - bez tej gałęzi
  // strona pokazywałaby mylące "Nie masz jeszcze żadnych koni".
  loadFailed = true;
}

// Nowy dzień dostaje podpowiedź z ostatnio ułożonego dnia - ośrodki pracują w rytmie,
// więc przepisywanie tego samego zakresu to najczęstsza czynność na tym ekranie.
const hint = scheduleDay ?? latestDay;
const openHour = hint?.openHour ?? "";
const closeHour = hint?.closeHour ?? "";
const selectedHorseIds = hint?.horseIds ?? [];

// Wycofane konie pokazujemy tylko wtedy, gdy są już przypisane do tego dnia.
const selectableHorses = horses.filter((horse) => horse.active || selectedHorseIds.includes(horse.id));

const dayLabel = new Date(`${day}T00:00:00`).toLocaleDateString("pl-PL", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout title={`Grafik ${day}`}>
  <Topbar />
  <main class="container-narrow page">
    <h1>Grafik dnia</h1>
    <p class="page-lead">Zakres godzin i konie pracujące danego dnia. Zakres 10–16 oznacza jazdy od 10:00 do 15:00.</p>

    <DayNav>
      <a slot="prev" href={`/osrodek/grafik?dzien=${addDays(day, -1)}`}>
        <ChevronLeft className="size-4" />
        Poprzedni
      </a>
      <Fragment slot="date">{dayLabel}</Fragment>
      <a slot="next" href={`/osrodek/grafik?dzien=${addDays(day, 1)}`}>
        Następny
        <ChevronRight className="size-4" />
      </a>
    </DayNav>

    {
      loadFailed ? (
        <FailureState>
          <p>Nie udało się wczytać grafiku.</p>
          <p>Odśwież stronę za chwilę.</p>
        </FailureState>
      ) : readOnly ? (
        <Card>
          <div class="past">
            <p class="past__flag">Dzień miniony — tylko do odczytu.</p>
            {scheduleDay ? (
              <dl>
                <div>
                  <dt>Godziny pracy</dt>
                  <dd class="mono-nums">
                    {scheduleDay.openHour}–{scheduleDay.closeHour}
                  </dd>
                </div>
                <div>
                  <dt>Konie</dt>
                  <dd>
                    {horses
                      .filter((horse) => scheduleDay.horseIds.includes(horse.id))
                      .map((horse) => horse.name)
                      .join(", ") || "brak"}
                  </dd>
                </div>
              </dl>
            ) : (
              <p class="past__none">Tego dnia nie było ułożonego grafiku.</p>
            )}
          </div>
        </Card>
      ) : horses.length === 0 ? (
        <Card>
          <EmptyState>
            <p>
              Nie masz jeszcze żadnych koni. Grafik przydziela konie do godzin, więc bez stada nie ma czego układać.
            </p>
            <a href="/osrodek/konie">Dodaj pierwszego konia</a>
          </EmptyState>
        </Card>
      ) : (
        <Card>
          <ScheduleDayForm
            day={day}
            openHour={openHour}
            closeHour={closeHour}
            selectedHorseIds={selectedHorseIds}
            horses={selectableHorses}
            serverError={error}
            client:load
          />
        </Card>
      )
    }

    {
      !scheduleDay && latestDay && !readOnly && (
        <p class="prefill">Pola wypełniono wartościami z ostatnio ułożonego dnia ({latestDay.day}).</p>
      )
    }
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  h1 {
    font-size: 32px;
  }
  .page-lead {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }

  /* ── Dzień miniony ────────────────────────────────────────────────────── */
  .past__flag {
    margin: 0;
    padding: 10px 14px;
    background: var(--surface-2);
    border-radius: var(--r);
    font-size: 13.5px;
    color: var(--muted);
  }
  .past dl {
    margin: 16px 0 0;
    display: grid;
    gap: 10px;
  }
  .past dt {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .past dd {
    margin: 2px 0 0;
    font-size: 15px;
    font-weight: 500;
  }
  .past__none {
    margin: 16px 0 0;
    color: var(--muted);
  }

  .prefill {
    margin: 12px 0 0;
    text-align: center;
    font-size: 13px;
    color: var(--faint);
  }
</style>
