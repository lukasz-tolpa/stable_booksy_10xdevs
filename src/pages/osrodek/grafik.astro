---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ScheduleDayPage from "@/components/schedule/ScheduleDayPage.astro";
import { OWNER_SCHEDULE_ROUTE } from "@/lib/auth/roles";
import { defaultScheduleDate, parseScheduleDate } from "@/lib/schedule/dates";

// Grafik dnia właściciela. Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles); konto
// ośrodka ma gwarantowaną stadninę dzięki wymuszeniu z S-01.
const day = parseScheduleDate(Astro.url.searchParams.get("dzien")) ?? defaultScheduleDate();
---

<Layout title={`Grafik ${day}`}>
  <Topbar />
  <main class="container-narrow page">
    <ScheduleDayPage
      route={OWNER_SCHEDULE_ROUTE}
      day={day}
      horsesRoute="/osrodek/konie"
      error={Astro.url.searchParams.get("error")}
    />
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
</style>
