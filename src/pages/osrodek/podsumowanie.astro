---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import MonthNav from "@/components/month-summary/MonthNav.astro";
import RiderRides from "@/components/month-summary/RiderRides.astro";
import Card from "@/components/ui/Card.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import { listStableInstructors } from "@/lib/instructors/queries";
import { logError } from "@/lib/log";
import { MONTH_PARAM, resolveSummaryMonth } from "@/lib/month-summary/month";
import {
  composeOwnerMonthSummary,
  INSTRUCTOR_PARAM,
  OWNER_MONTH_SUMMARY_ROUTE,
  ownerMonthHref,
  type OwnerMonthSummaryView,
} from "@/lib/month-summary/owner";
import { composeMonthNav } from "@/lib/month-summary/summary";
import { MONTH_SUMMARY_TEXTS } from "@/lib/month-summary/texts";
import { todayIso } from "@/lib/schedule/dates";
import { getOwnedStableId, listStableHorses } from "@/lib/stables/queries";
import { getStatsRows } from "@/lib/stats/queries";
import { createClient } from "@/lib/supabase";

// Podsumowanie miesiąca właściciela (#88). Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles):
// przestrzeń ośrodka jest tylko dla właściciela. Liczy `@/lib/month-summary/owner`; tu tylko odczyt
// i render. Miesiąc i filtr instruktora żyją w adresie (`?miesiac=RRRR-MM&instruktor=<id>`), więc
// odświeżenie ich nie gubi; filtr to formularz GET, działa bez JavaScriptu (#89).
const { profile } = Astro.locals;
const SCOPE = "page:osrodek/podsumowanie";
const texts = MONTH_SUMMARY_TEXTS;
const now = new Date();
const month = resolveSummaryMonth(Astro.url.searchParams.get(MONTH_PARAM), todayIso(now));

const supabase = createClient(Astro.request.headers, Astro.cookies);

let view: OwnerMonthSummaryView | null = null;

if (supabase && profile) {
  try {
    const stableId = await getOwnedStableId(supabase, profile.id);
    if (stableId === null) {
      // Middleware nie wpuszcza tu właściciela bez stadniny; jej brak to awaria odczytu, nie pusty miesiąc.
      logError(SCOPE, new Error("Brak stadniny dla konta właściciela"));
    } else {
      // Stado i instruktorzy obejmują zdezaktywowanych — jedyne źródło nazw przy minionych jazdach.
      const [rows, horses, instructors] = await Promise.all([
        getStatsRows(supabase, stableId, { from: month.from, to: month.to }),
        listStableHorses(supabase, stableId),
        listStableInstructors(supabase, stableId),
      ]);
      view = composeOwnerMonthSummary(
        { month, ...rows, horses, instructors, instructorParam: Astro.url.searchParams.get(INSTRUCTOR_PARAM) },
        now,
      );
    }
  } catch (error) {
    logError(SCOPE, error);
  }
}

// Przełącznik miesięcy zostaje także przy awarii odczytu — da się przejść do innego miesiąca.
const nav = view?.nav ?? composeMonthNav(month, ownerMonthHref);
// Filtr tylko gdy jest z kogo wybierać: miesiąc bez jazd ma w nim samo „Wszyscy instruktorzy”.
const filter = view && view.filter.options.length > 1 ? view.filter : null;
---

<Layout title={texts.heading}>
  <Topbar />
  <main class="container-narrow page">
    <h1>{texts.heading}</h1>
    <p class="page-lead">{texts.owner.lead}</p>

    <MonthNav nav={nav} />

    {
      filter && (
        <form method="get" action={OWNER_MONTH_SUMMARY_ROUTE} class="filter" aria-label={texts.owner.filter.name}>
          <input type="hidden" name={MONTH_PARAM} value={month.month} />
          <label for="instruktor">{texts.owner.filter.label}</label>
          <select id="instruktor" name={INSTRUCTOR_PARAM}>
            {filter.options.map((option) => (
              <option value={option.value} selected={option.selected}>
                {option.label}
              </option>
            ))}
          </select>
          <button type="submit">{texts.owner.filter.submit}</button>
        </form>
      )
    }

    {
      !view ? (
        <FailureState>
          <p>{texts.failure}</p>
          <p>{texts.retry}</p>
        </FailureState>
      ) : view.isEmpty ? (
        <Card>
          <EmptyState>
            <p>{view.emptyText}</p>
            <p>{texts.emptyHint}</p>
          </EmptyState>
        </Card>
      ) : (
        <section aria-labelledby="riders-heading">
          <h2 id="riders-heading">{texts.ridersHeading}</h2>
          <RiderRides list={view.list} labelledby="riders-heading" />
        </section>
      )
    }
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  h1 {
    font-size: 32px;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 20px;
  }
  .page-lead {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }

  /* Filtr instruktora: etykieta nad listą wyboru i przyciskiem na telefonie, w jednym rzędzie od `sm`.
     Lista i przycisk mają cel dotyku 44 px (DESIGN.md). */
  .filter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 6px 10px;
    margin: 0 0 18px;
  }
  .filter label {
    grid-column: 1 / -1;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted);
  }
  .filter select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--border-2);
    border-radius: var(--r);
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: 15px;
  }
  .filter select:focus-visible {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-soft);
  }
  .filter button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    background: var(--surface);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    color: var(--fg);
    cursor: pointer;
    transition: background 0.15s;
  }
  .filter button:hover {
    background: var(--surface-2);
  }
  .filter button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  @media (width >= 640px) {
    .filter {
      grid-template-columns: auto minmax(0, 320px) auto;
      justify-content: start;
    }
    .filter label {
      grid-column: auto;
    }
  }
</style>
