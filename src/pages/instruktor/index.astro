---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import InstructorTabs from "@/components/instructors/InstructorTabs.astro";
import Card from "@/components/ui/Card.astro";
import GhostButton from "@/components/ui/GhostButton.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import Tag from "@/components/ui/Tag.astro";
import { formatClockHour, formatLongDate, formatTakenSeats } from "@/lib/format";
import { composeMySlots, type MySlotsDay } from "@/lib/my-slots/compose";
import { getOwnInstructor } from "@/lib/instructors/queries";
import { getMySlotBookings, getMySlotHorseOptions, getMySlots } from "@/lib/my-slots/queries";
import { mySlotsSuccessMessage } from "@/lib/my-slots/redirect";
import { NO_HORSE } from "@/lib/bookings/rows";
import { todayIso } from "@/lib/schedule/dates";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

// „Moje sloty” instruktora, który nie jest właścicielem (#72). Dostęp pilnuje middleware
// (mapa tras w @/lib/auth/roles): właściciela przenosi do przestrzeni ośrodka. Świeże zapisy
// i odwołania widać po odświeżeniu strony. Przy każdym zapisie instruktor przydziela konia (#81):
// formularz bez JavaScriptu, zajęte o tej godzinie konie są na liście, ale nie da się ich wybrać.
const { profile } = Astro.locals;
const today = todayIso();
const error = Astro.url.searchParams.get("error");
const successMessage = mySlotsSuccessMessage(Astro.url.searchParams.get("sukces"));

const supabase = createClient(Astro.request.headers, Astro.cookies);

let stableName: string | null = null;
let days: MySlotsDay[] = [];
let loadFailed = false;

if (supabase && profile) {
  try {
    const { instructor, error } = await getOwnInstructor(supabase);
    if (error) {
      throw error;
    }
    if (instructor) {
      stableName = instructor.stableName;
      const [slots, bookings, horseOptions] = await Promise.all([
        getMySlots(supabase, instructor.id, today),
        getMySlotBookings(supabase, today),
        getMySlotHorseOptions(supabase, today),
      ]);
      days = composeMySlots({ slots, bookings, horseOptions });
    }
  } catch (error) {
    loadFailed = true;
    logError("page:instruktor", error);
  }
} else {
  // Brak klienta Supabase lub profilu to awaria konfiguracji, nie pusta lista.
  loadFailed = true;
}
---

<Layout title="Moje sloty">
  <Topbar />
  <main class="container-narrow page">
    <InstructorTabs />
    <h1>Moje sloty</h1>
    <p class="page-lead">
      {stableName ? `Twoje godziny w ośrodku ${stableName}, od dziś.` : "Twoje godziny od dziś."} Odśwież stronę, żeby zobaczyć
      najnowsze zapisy i odwołania.
    </p>

    {
      successMessage && (
        <div class="notice">
          <Banner variant="success">{successMessage}</Banner>
        </div>
      )
    }
    {
      error && (
        <div class="notice">
          <Banner variant="error">{error}</Banner>
        </div>
      )
    }

    {
      loadFailed ? (
        <div class="section">
          <FailureState>
            <p>Nie udało się wczytać slotów.</p>
            <p>Odśwież stronę za chwilę.</p>
          </FailureState>
        </div>
      ) : days.length === 0 ? (
        <div class="section">
          <Card>
            <EmptyState>
              <p>Nie prowadzisz żadnej jazdy od dziś.</p>
              <p>Godziny i limity miejsc ustala właściciel ośrodka w grafiku dnia.</p>
            </EmptyState>
          </Card>
        </div>
      ) : (
        days.map((day) => (
          <section class="section" aria-labelledby={`day-${day.day}`}>
            <Card>
              <h2 id={`day-${day.day}`}>{formatLongDate(day.day)}</h2>
              <ul class="slots">
                {day.slots.map((slot) => (
                  <li>
                    <div class="slot__head">
                      {/* Cały tekst tego elementu to sama godzina. */}
                      <span class="slot__when">{formatClockHour(slot.hour)}</span>
                      <span class="slot__place">{slot.placeName}</span>
                      <span class="slot__seats">{formatTakenSeats(slot.taken, slot.seats)}</span>
                    </div>
                    {slot.riders.length === 0 ? (
                      <p class="slot__empty">Nikt jeszcze się nie zapisał.</p>
                    ) : (
                      <ul class="riders">
                        {slot.riders.map((rider) => (
                          <li>
                            <span class="rider__name">{rider.name}</span>
                            {rider.hasHorse ? (
                              <span class="rider__horse">{rider.horse}</span>
                            ) : (
                              <Tag variant="warn">{rider.horse}</Tag>
                            )}
                            <form method="post" action="/api/bookings/instructor-assign-horse" class="assign">
                              <input type="hidden" name="bookingId" value={rider.bookingId} />
                              <label for={`horse-${String(rider.bookingId)}`}>
                                Koń<span class="sr-only"> — {rider.name}</span>
                              </label>
                              <select id={`horse-${String(rider.bookingId)}`} name="horseId">
                                <option value="" selected={!rider.hasHorse}>
                                  {NO_HORSE}
                                </option>
                                {rider.horseChoices.map((horse) => (
                                  <option value={horse.id} selected={horse.selected} disabled={horse.taken}>
                                    {horse.label}
                                  </option>
                                ))}
                              </select>
                              <GhostButton>Zapisz konia</GhostButton>
                            </form>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </Card>
          </section>
        ))
      )
    }
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  h1 {
    font-size: 32px;
  }
  .notice {
    margin-top: 18px;
  }
  .page-lead {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }
  .section {
    display: block;
    margin-top: 18px;
  }
  h2 {
    font-size: 22px;
    margin: 0 0 14px;
  }
  h2::first-letter {
    text-transform: uppercase;
  }

  .slots,
  .riders {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .slots > li {
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }
  .slots > li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .slots > li:last-child {
    padding-bottom: 0;
  }
  .slot__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }
  .slot__when {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  .slot__place {
    font-weight: 600;
    font-size: 14.5px;
  }
  .slot__seats {
    color: var(--muted);
    font-size: 14.5px;
  }
  .slot__empty {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14.5px;
  }
  .riders {
    margin-top: 8px;
    display: grid;
    gap: 6px;
  }
  .riders > li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    min-width: 0;
  }
  .rider__name {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .rider__horse {
    color: var(--muted);
    font-size: 14.5px;
  }

  .assign {
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }
  .assign label {
    font-size: 13px;
    font-weight: 600;
  }
  .assign select {
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--border-2);
    border-radius: 12px;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: 14.5px;
  }
  .assign select:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>
