---
import { ArrowLeft, CalendarX2 } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import Card from "@/components/ui/Card.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import { ROLE_HOME } from "@/lib/auth/roles";
import { getRiderBookings } from "@/lib/bookings/queries";
import { splitRiderBookings, type RiderBookingSections } from "@/lib/bookings/rider-list";
import { currentWarsawHour } from "@/lib/bookings/slots";
import { todayIso } from "@/lib/schedule/dates";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles). Strona pokazuje
// wyłącznie zapisy zalogowanego jeźdźca - filtr po rider_id jest jawny
// w getRiderBookings, nie zostawiony RLS.
const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("sukces") === "1";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let sections: RiderBookingSections = { upcoming: [], history: [] };
let loadFailed = false;

if (supabase && user) {
  try {
    const bookings = await getRiderBookings(supabase, user.id);
    sections = splitRiderBookings(bookings, { today: todayIso(), currentHour: currentWarsawHour() });
  } catch (error) {
    loadFailed = true;
    logError("page:jezdziec/zapisy", error);
  }
} else {
  // Brak klienta Supabase lub sesji to awaria konfiguracji, nie brak zapisów.
  loadFailed = true;
}

// Lista jest wielodniowa, więc data w wierszu ma format krótki - pełny dayLabel
// z dniem tygodnia byłby za długi na telefonie.
function formatDay(day: string): string {
  return new Date(`${day}T00:00:00`).toLocaleDateString("pl-PL", { day: "numeric", month: "long" });
}
---

<Layout title="Moje zapisy">
  <Topbar />
  <main class="container-narrow page">
    <a href={ROLE_HOME.rider} class="back">
      <ArrowLeft className="size-4" />
      Wróć do listy ośrodków
    </a>

    <h1>Moje zapisy</h1>
    <p class="page-lead">Nadchodzące jazdy możesz odwołać do momentu ich rozpoczęcia.</p>

    {
      success && (
        <div class="notice">
          <Banner variant="success">Zapis został odwołany. Slot wrócił do puli wolnych.</Banner>
        </div>
      )
    }
    {
      error && (
        <div class="notice">
          <Banner variant="error">{error}</Banner>
        </div>
      )
    }

    <section class="upcoming">
      <Card>
        <h2>Nadchodzące</h2>
        {
          loadFailed ? (
            /* Nagłówek sekcji zostaje, a w środku siada karta awarii - „nie udało się
               wczytać" to inna sytuacja niż „nie masz zapisów" i ma to być widać. */
            <FailureState>
              <p>Nie udało się wczytać zapisów.</p>
              <p>Odśwież stronę za chwilę.</p>
            </FailureState>
          ) : sections.upcoming.length === 0 ? (
            <EmptyState>
              <p>Nie masz nadchodzących zapisów.</p>
              <a href={ROLE_HOME.rider}>Przeglądaj ośrodki i zapisz się na jazdę</a>
            </EmptyState>
          ) : (
            <ul class="rows">
              {sections.upcoming.map((row) => (
                <li>
                  <span class="row__when">
                    {formatDay(row.day)}, {row.hour}:00
                  </span>
                  {/* Nazwa ośrodka i konia siedzą w tym samym wierszu co przycisk -
                      scenariusz odwołania zawęża <li> po wszystkich trzech naraz. */}
                  <span class="row__meta">
                    <span class="row__sub">{row.stableName}</span>
                    <span class="row__horse">{row.horseName}</span>
                  </span>
                  <form method="post" action="/api/bookings/cancel" class="row__action">
                    <input type="hidden" name="bookingId" value={row.id} />
                    <button type="submit">
                      <CalendarX2 className="size-4" />
                      Odwołaj
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )
        }
      </Card>
    </section>

    {
      !loadFailed && sections.history.length > 0 && (
        <section class="history">
          <Card>
            <h2>Minione i odwołane</h2>
            <ul class="rows rows--history">
              {sections.history.map((row) => (
                <li>
                  <span class="row__when">
                    {formatDay(row.day)}, {row.hour}:00
                  </span>
                  <span class="row__meta">
                    <span class="row__sub">{row.stableName}</span>
                    <span class="row__horse">{row.horseName}</span>
                    {/* Cały tekst tego elementu to samo słowo - scenariusz odwołania
                        szuka wiersza po dokładnym dopasowaniu. */}
                    {row.status === "cancelled" && <span class="tag">odwołany</span>}
                  </span>
                </li>
              ))}
            </ul>
          </Card>
        </section>
      )
    }
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-bottom: 12px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--primary);
  }
  .back:hover {
    color: var(--primary-strong);
    text-decoration: underline;
  }
  .back:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
    border-radius: 8px;
  }

  h1 {
    font-size: 32px;
  }
  .page-lead {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }
  .notice {
    margin-top: 16px;
  }

  .upcoming {
    display: block;
    margin-top: 22px;
  }
  .history {
    display: block;
    margin-top: 18px;
  }
  h2 {
    font-size: 22px;
    margin: 0 0 14px;
  }
  .history h2 {
    color: var(--muted);
  }

  /* ── Jeden wzorzec wiersza dla obu list ───────────────────────────────── */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows > li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }
  .rows > li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .rows > li:last-child {
    padding-bottom: 0;
  }

  .row__when {
    order: 1;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  /* Do 560 px „Odwołaj" trzyma prawą krawędź pierwszej linii, a opis schodzi niżej. */
  .row__action {
    order: 2;
    margin-left: auto;
  }
  .row__meta {
    order: 3;
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    min-width: 0;
  }
  @media (width >= 560px) {
    .row__meta {
      order: 2;
      flex-basis: auto;
    }
    .row__action {
      order: 3;
    }
  }
  .row__horse {
    font-weight: 600;
  }
  .row__sub {
    color: var(--muted);
    font-size: 14.5px;
    overflow-wrap: anywhere;
  }
  .rows--history .row__when,
  .rows--history .row__horse {
    font-weight: 500;
    color: var(--muted);
  }

  /* Neutralna pigułka - świadomie NIE kasztanowa, żeby nie czytała się jak akcent. */
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    background: var(--surface-3);
    color: var(--muted);
  }

  .row__action button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 15px;
    border-radius: 999px;
    border: 1px solid oklch(56% 0.18 25 / 0.35);
    background: var(--surface);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--danger-ink);
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .row__action button:hover {
    background: var(--danger-soft);
    border-color: var(--danger);
  }
  .row__action button:focus-visible {
    outline: 2px solid var(--danger);
    outline-offset: 2px;
  }
</style>
