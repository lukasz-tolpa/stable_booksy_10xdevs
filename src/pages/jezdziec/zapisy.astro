---
import { ArrowLeft, CalendarX2 } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { ROLE_HOME } from "@/lib/auth/roles";
import { getRiderBookings } from "@/lib/bookings/queries";
import { splitRiderBookings, type RiderBookingSections } from "@/lib/bookings/rider-list";
import { currentWarsawHour } from "@/lib/bookings/slots";
import { todayIso } from "@/lib/schedule/dates";
import { createClient } from "@/lib/supabase";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles). Strona pokazuje
// wyłącznie zapisy zalogowanego jeźdźca - filtr po rider_id jest jawny
// w getRiderBookings, nie zostawiony RLS.
const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("sukces") === "1";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let sections: RiderBookingSections = { upcoming: [], history: [] };
let loadFailed = false;

if (supabase && user) {
  try {
    const bookings = await getRiderBookings(supabase, user.id);
    sections = splitRiderBookings(bookings, { today: todayIso(), currentHour: currentWarsawHour() });
  } catch {
    loadFailed = true;
  }
} else {
  // Brak klienta Supabase lub sesji to awaria konfiguracji, nie brak zapisów.
  loadFailed = true;
}

// Lista jest wielodniowa, więc data w wierszu ma format krótki - pełny dayLabel
// z dniem tygodnia byłby za długi na telefonie.
function formatDay(day: string): string {
  return new Date(`${day}T00:00:00`).toLocaleDateString("pl-PL", { day: "numeric", month: "long" });
}
---

<Layout title="Moje zapisy">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />

      <a
        href={ROLE_HOME.rider}
        class="mb-4 inline-flex items-center gap-1.5 text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
      >
        <ArrowLeft className="size-4" />
        Wróć do listy ośrodków
      </a>

      <h1 class="mb-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Moje zapisy
      </h1>
      <p class="mb-6 text-sm text-blue-100/70">Nadchodzące jazdy możesz odwołać do momentu ich rozpoczęcia.</p>

      {
        success && (
          <p class="mb-4 rounded-lg border border-emerald-500/30 bg-emerald-900/20 px-4 py-3 text-sm text-emerald-200">
            Zapis został odwołany. Slot wrócił do puli wolnych.
          </p>
        )
      }
      {
        error && (
          <p class="mb-4 rounded-lg border border-red-500/30 bg-red-900/20 px-4 py-3 text-sm text-red-200">{error}</p>
        )
      }

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold text-white">Nadchodzące</h2>
        {
          loadFailed ? (
            <div class="py-4 text-center">
              <p class="text-red-200">Nie udało się wczytać zapisów.</p>
              <p class="mt-2 text-sm text-blue-100/50">Odśwież stronę za chwilę.</p>
            </div>
          ) : sections.upcoming.length === 0 ? (
            <div class="py-4 text-center">
              <p class="text-blue-100/80">Nie masz nadchodzących zapisów.</p>
              <a
                href={ROLE_HOME.rider}
                class="mt-3 inline-block text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
              >
                Przeglądaj ośrodki i zapisz się na jazdę
              </a>
            </div>
          ) : (
            <ul class="divide-y divide-white/10">
              {sections.upcoming.map((row) => (
                <li class="flex flex-wrap items-center gap-x-3 gap-y-2 py-3">
                  <span class="font-semibold text-purple-200">
                    {formatDay(row.day)}, {row.hour}:00
                  </span>
                  <span class="font-medium text-white">{row.horseName}</span>
                  <span class="text-blue-100/70">{row.stableName}</span>
                  <form method="post" action="/api/bookings/cancel" class="ml-auto">
                    <input type="hidden" name="bookingId" value={row.id} />
                    <button
                      type="submit"
                      class="inline-flex items-center gap-1.5 rounded-lg border border-red-500/30 bg-red-900/20 px-3 py-1.5 text-sm text-red-200 transition-colors hover:border-red-400/50 hover:bg-red-900/40"
                    >
                      <CalendarX2 className="size-4" />
                      Odwołaj
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        !loadFailed && sections.history.length > 0 && (
          <div class="mt-6 rounded-2xl border border-white/10 bg-white/5 p-6 text-white">
            <h2 class="mb-4 text-lg font-semibold text-blue-100/70">Minione i odwołane</h2>
            <ul class="divide-y divide-white/5">
              {sections.history.map((row) => (
                <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3 text-blue-100/50">
                  <span>
                    {formatDay(row.day)}, {row.hour}:00
                  </span>
                  <span>{row.horseName}</span>
                  <span>{row.stableName}</span>
                  {row.status === "cancelled" && (
                    <span class="rounded bg-white/10 px-2 py-0.5 text-xs text-blue-100/60">odwołany</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</Layout>
