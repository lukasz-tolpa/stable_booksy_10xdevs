---
import { ArrowLeft, Check, ChevronLeft, ChevronRight, MapPin } from "lucide-react";
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import Card from "@/components/ui/Card.astro";
import DayNav from "@/components/ui/DayNav.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import Layout from "@/layouts/Layout.astro";
import { ROLE_HOME } from "@/lib/auth/roles";
import { getMyBookings, getTakenSlots } from "@/lib/bookings/queries";
import { assignedHorses, computeSlotSections, currentWarsawHour, type SlotSection } from "@/lib/bookings/slots";
import { addDays, defaultScheduleDate, isPastDate, parseScheduleDate, todayIso } from "@/lib/schedule/dates";
import { getScheduleDay, type ScheduleDayData } from "@/lib/schedule/queries";
import { getStableById, listStableHorses, type StableListItem } from "@/lib/stables/queries";
import { parseStableId } from "@/lib/stables/search";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

// Trasa leży pod prefiksem /jezdziec, więc dostęp pilnuje middleware (mapa tras
// w @/lib/auth/roles) - konto ośrodka jest stąd przekierowywane do siebie.
const { user } = Astro.locals;
const id = parseStableId(Astro.params.id);
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("sukces") === "1";

// Data przeszła jest traktowana jak niepoprawna - nie ma czego rezerwować wstecz,
// więc wracamy do domyślnego jutra zamiast pokazywać martwy dzień.
const requestedDay = parseScheduleDate(Astro.url.searchParams.get("dzien"));
const day = requestedDay !== null && !isPastDate(requestedDay) ? requestedDay : defaultScheduleDate();
const today = todayIso();

const supabase = createClient(Astro.request.headers, Astro.cookies);

let stable: StableListItem | null = null;
let scheduleDay: ScheduleDayData | null = null;
let sections: SlotSection[] = [];
let loadFailed = false;

if (id !== null && supabase && user) {
  try {
    stable = await getStableById(supabase, id);

    if (stable) {
      scheduleDay = await getScheduleDay(supabase, id, day);
    }

    if (stable && scheduleDay) {
      const [horses, takenSlots, myBookings] = await Promise.all([
        listStableHorses(supabase, id),
        getTakenSlots(supabase, id, day),
        getMyBookings(supabase, scheduleDay.id, user.id),
      ]);

      // Konie wg przydziału do dnia — reguła żyje w `assignedHorses` (czysta, testowana
      // jednostkowo); nazwy dokłada lista stada.
      sections = computeSlotSections({
        openHour: scheduleDay.openHour,
        closeHour: scheduleDay.closeHour,
        horses: assignedHorses(horses, scheduleDay.horseIds),
        takenSlots,
        myBookings,
        currentHour: day === today ? currentWarsawHour() : null,
      });
    }
  } catch (error) {
    loadFailed = true;
    logError("page:jezdziec/osrodki/[id]", error);
  }
} else if (id !== null) {
  // Brak klienta Supabase lub sesji przy poprawnym identyfikatorze to awaria
  // konfiguracji, nie brak ośrodka - "nie znaleziono" byłoby kłamstwem.
  loadFailed = true;
}

const previousDay = addDays(day, -1);
const canGoBack = !isPastDate(previousDay);

const dayLabel = new Date(`${day}T00:00:00`).toLocaleDateString("pl-PL", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout title={stable ? stable.name : "Nie znaleziono ośrodka"}>
  <Topbar />
  <main class="container-narrow page">
    <a href={ROLE_HOME.rider} class="back">
      <ArrowLeft className="size-4" />
      Wróć do listy ośrodków
    </a>

    {
      loadFailed ? (
        <FailureState>
          <p>Nie udało się wczytać ośrodka.</p>
          <p>Odśwież stronę za chwilę.</p>
        </FailureState>
      ) : stable ? (
        <div>
          <Card>
            <div class="stable">
              <h1>{stable.name}</h1>
              <p class="city">
                <MapPin className="size-4" />
                {stable.city}
              </p>
              {stable.description && <p class="desc">{stable.description}</p>}
            </div>
          </Card>

          {success && (
            <div class="notice">
              <Banner variant="success">Zapisano na jazdę. Twój slot jest oznaczony poniżej.</Banner>
            </div>
          )}
          {error && (
            <div class="notice">
              <Banner variant="error">{error}</Banner>
            </div>
          )}

          <DayNav>
            {canGoBack ? (
              <a slot="prev" href={`/jezdziec/osrodki/${id}?dzien=${previousDay}`}>
                <ChevronLeft className="size-4" />
                Poprzedni
              </a>
            ) : (
              <span slot="prev" class="off">
                <ChevronLeft className="size-4" />
                Poprzedni
              </span>
            )}
            <Fragment slot="date">{dayLabel}</Fragment>
            <a slot="next" href={`/jezdziec/osrodki/${id}?dzien=${addDays(day, 1)}`}>
              Następny
              <ChevronRight className="size-4" />
            </a>
          </DayNav>

          <form method="get" class="daypick">
            <label for="dzien">Wybierz dzień:</label>
            <input type="date" id="dzien" name="dzien" value={day} min={today} />
            <button type="submit">Pokaż</button>
          </form>

          <Card>
            <h2 class="section">Wolne sloty</h2>
            {!scheduleDay ? (
              <EmptyState>
                <p>Ośrodek nie ułożył grafiku na ten dzień.</p>
                <p>Wybierz inny dzień albo zajrzyj tu później.</p>
              </EmptyState>
            ) : sections.length === 0 ? (
              <EmptyState>
                <p>Brak wolnych slotów tego dnia.</p>
                <p>Wszystkie terminy są zajęte albo już minęły.</p>
              </EmptyState>
            ) : (
              <ul class="hours">
                {sections.map((section) => (
                  <li>
                    {/* Cały tekst tego elementu to sama godzina - scenariusze e2e
                        zawężają wiersz przez dokładne dopasowanie "11:00". */}
                    <span class="hours__label">{section.hour}:00</span>
                    <div class="slots">
                      {section.horses.map((horse) =>
                        horse.status === "mine" ? (
                          <span class="slot slot--mine">
                            <Check className="size-[15px]" aria-hidden="true" />
                            {horse.name} — Twój zapis
                          </span>
                        ) : (
                          /* `display: contents` na formularzu, żeby pigułki układały
                             się w jednym wierszu flex mimo opakowania w <form>. */
                          <form method="post" action="/api/bookings/create">
                            <input type="hidden" name="stableId" value={id} />
                            <input type="hidden" name="day" value={day} />
                            <input type="hidden" name="horseId" value={horse.id} />
                            <input type="hidden" name="hour" value={section.hour} />
                            {/* Jedyną treścią przycisku jest imię konia - to nazwa
                                dostępna, po której scenariusze go znajdują. */}
                            <button type="submit" class="slot slot--free">
                              {horse.name}
                            </button>
                          </form>
                        ),
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </Card>
        </div>
      ) : (
        /* Niepoprawny identyfikator i brak wiersza to dla użytkownika ta sama sytuacja,
           więc nie rozróżniamy ich w komunikacie. */
        <Card>
          <EmptyState>
            <p>Nie znaleziono takiego ośrodka.</p>
            <p>Być może został usunięty albo adres jest nieprawidłowy.</p>
          </EmptyState>
        </Card>
      )
    }
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-bottom: 12px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--primary);
  }
  .back:hover {
    color: var(--primary-strong);
    text-decoration: underline;
  }
  .back:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
    border-radius: 8px;
  }

  /* Banner sam nie nosi marginesu - odstęp należy do miejsca, w którym stoi. */
  .notice {
    margin-top: 16px;
  }

  /* ── Nagłówek ośrodka ─────────────────────────────────────────────────── */
  .stable h1 {
    font-size: 30px;
  }
  .stable .city {
    margin: 10px 0 0;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .stable .desc {
    margin: 12px 0 0;
    color: var(--muted);
    max-width: 62ch;
  }

  /* ── Wybór dnia ───────────────────────────────────────────────────────── */
  .daypick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }
  .daypick label {
    font-size: 14.5px;
    font-weight: 600;
  }
  .daypick input {
    min-height: 44px;
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--border-2);
    border-radius: var(--r);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 14.5px;
    color: var(--fg);
    color-scheme: light;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .daypick input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-soft);
  }
  .daypick button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    background: var(--surface);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    color: var(--fg);
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .daypick button:hover {
    background: var(--surface-2);
  }
  .daypick button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* ── Siatka slotów — DESIGN.md §5 ─────────────────────────────────────── */
  h2.section {
    font-size: 22px;
    margin-bottom: 14px;
  }
  .hours {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .hours > li {
    padding: 14px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--r);
  }
  .hours__label {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    font-weight: 600;
    color: var(--fg);
  }
  .slots {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .slots form {
    display: contents;
  }
  .slot {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    /* 44 px to minimalny cel dotykowy - PRD wymaga wygody na telefonie. */
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .slot--free {
    background: var(--surface);
    color: var(--fg);
    border-color: var(--border-2);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s;
  }
  .slot--free:hover {
    background: var(--primary-soft);
    border-color: var(--primary);
    color: var(--primary-strong);
  }
  .slot--free:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  /* Jedyne wystąpienie kasztanu na tym ekranie (DESIGN.md §7). */
  .slot--mine {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
</style>
