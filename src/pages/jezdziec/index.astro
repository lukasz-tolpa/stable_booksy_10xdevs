---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import StableCard from "@/components/stables/StableCard.astro";
import StableFilter from "@/components/stables/StableFilter.astro";
import Card from "@/components/ui/Card.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import { ROLE_HOME } from "@/lib/auth/roles";
import { listStables, type StableListItem } from "@/lib/stables/queries";
import { prepareSearchTerm } from "@/lib/stables/search";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles) - strona nie powtarza
// sprawdzenia roli. Odczyt `stables` jest otwarty dla zalogowanych (F-01), więc
// katalog nie potrzebuje żadnego filtra po właścicielu.
const rawQuery = Astro.url.searchParams.get("q") ?? "";
const term = prepareSearchTerm(rawQuery);

const supabase = createClient(Astro.request.headers, Astro.cookies);

// Awaria odczytu nie może zamienić ekranu startowego jeźdźca w stronę 500 -
// pokazujemy stan awarii obok dwóch stanów pustych.
let stables: StableListItem[] = [];
let loadFailed = false;

if (supabase) {
  try {
    stables = await listStables(supabase, term);
  } catch (error) {
    loadFailed = true;
    logError("page:jezdziec/index", error);
  }
}

const isFiltered = term !== null;
const isEmpty = stables.length === 0;
---

<Layout title="Ośrodki">
  <Topbar />
  <main class="container-narrow page">
    <div class="page-head">
      <h1>Ośrodki</h1>
      <a href="/jezdziec/zapisy" class="btn-ghost">Moje zapisy</a>
    </div>
    <p class="page-lead">Wybierz ośrodek, w którym chcesz się zapisać na jazdę.</p>

    <StableFilter value={rawQuery} action={ROLE_HOME.rider} />

    {
      loadFailed ? (
        <FailureState>
          <p>Nie udało się wczytać listy ośrodków.</p>
          <p>Odśwież stronę za chwilę.</p>
        </FailureState>
      ) : isEmpty ? (
        <Card>
          <EmptyState>
            {isFiltered ? (
              <>
                {/* Stan pusty z aktywnym filtrem - odrębny od stanu "brak ośrodków",
                    bo na świeżo wdrożonej wersji ten drugi zobaczy każdy nowy jeździec. */}
                <p>Żaden ośrodek nie pasuje do wpisanej frazy.</p>
                <a href={ROLE_HOME.rider}>Pokaż wszystkie ośrodki</a>
              </>
            ) : (
              <>
                <p>Nie ma jeszcze żadnych ośrodków.</p>
                <p>Gdy pierwsza stadnina założy konto, pojawi się tutaj i będzie można zapisać się na jazdę.</p>
              </>
            )}
          </EmptyState>
        </Card>
      ) : (
        <div class="cards">
          {stables.map((stable) => (
            <StableCard stable={stable} />
          ))}
        </div>
      )
    }
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .page-head h1 {
    font-size: 32px;
  }
  .page-lead {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    background: var(--surface);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    color: var(--fg);
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .btn-ghost:hover {
    background: var(--surface-2);
  }
  .btn-ghost:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .cards {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  /* Próg z prototypu: dwie kolumny dopiero, gdy karta ma sensowną szerokość. */
  @media (width >= 620px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
