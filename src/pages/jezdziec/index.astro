---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import StableCard from "@/components/stables/StableCard.astro";
import StableFilter from "@/components/stables/StableFilter.astro";
import { ROLE_HOME } from "@/lib/auth/roles";
import { listStables, type StableListItem } from "@/lib/stables/queries";
import { prepareSearchTerm } from "@/lib/stables/search";
import { createClient } from "@/lib/supabase";
import { logError } from "@/lib/log";

// Dostęp pilnuje middleware (mapa tras w @/lib/auth/roles) - strona nie powtarza
// sprawdzenia roli. Odczyt `stables` jest otwarty dla zalogowanych (F-01), więc
// katalog nie potrzebuje żadnego filtra po właścicielu.
const rawQuery = Astro.url.searchParams.get("q") ?? "";
const term = prepareSearchTerm(rawQuery);

const supabase = createClient(Astro.request.headers, Astro.cookies);

// Awaria odczytu nie może zamienić ekranu startowego jeźdźca w stronę 500 -
// pokazujemy stan awarii obok dwóch stanów pustych.
let stables: StableListItem[] = [];
let loadFailed = false;

if (supabase) {
  try {
    stables = await listStables(supabase, term);
  } catch (error) {
    loadFailed = true;
    logError("page:jezdziec/index", error);
  }
}

const isFiltered = term !== null;
const isEmpty = stables.length === 0;
---

<Layout title="Ośrodki">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-3xl">
      <Topbar />

      <div class="mb-1 flex items-baseline justify-between gap-3">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Ośrodki
        </h1>
        <a
          href="/jezdziec/zapisy"
          class="rounded-lg border border-white/20 bg-white/5 px-4 py-2 text-sm text-purple-200 transition-colors hover:bg-white/10"
        >
          Moje zapisy
        </a>
      </div>
      <p class="mb-6 text-sm text-blue-100/70">Wybierz ośrodek, w którym chcesz się zapisać na jazdę.</p>

      <StableFilter value={rawQuery} action={ROLE_HOME.rider} />

      {
        loadFailed ? (
          <div class="rounded-2xl border border-red-500/30 bg-red-900/20 p-8 text-center text-white">
            <p class="text-red-200">Nie udało się wczytać listy ośrodków.</p>
            <p class="mt-2 text-sm text-blue-100/50">Odśwież stronę za chwilę.</p>
          </div>
        ) : isEmpty ? (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center text-white">
            {isFiltered ? (
              <>
                {/* Stan pusty z aktywnym filtrem - odrębny od stanu "brak ośrodków",
                    bo na świeżo wdrożonej wersji ten drugi zobaczy każdy nowy jeździec. */}
                <p class="text-blue-100/80">Żaden ośrodek nie pasuje do wpisanej frazy.</p>
                <a
                  href={ROLE_HOME.rider}
                  class="mt-3 inline-block text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                >
                  Pokaż wszystkie ośrodki
                </a>
              </>
            ) : (
              <>
                <p class="text-blue-100/80">Nie ma jeszcze żadnych ośrodków.</p>
                <p class="mt-2 text-sm text-blue-100/50">
                  Gdy pierwsza stadnina założy konto, pojawi się tutaj i będzie można zapisać się na jazdę.
                </p>
              </>
            )}
          </div>
        ) : (
          <div class="grid gap-4 sm:grid-cols-2">
            {stables.map((stable) => (
              <StableCard stable={stable} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</Layout>
