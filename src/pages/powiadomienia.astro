---
import { ChevronRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import Card from "@/components/ui/Card.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FailureState from "@/components/ui/FailureState.astro";
import Tag from "@/components/ui/Tag.astro";
import { isUserRole } from "@/lib/auth/roles";
import { formatClockHour, formatDateTime, formatLongDate } from "@/lib/format";
import { logError } from "@/lib/log";
import {
  composeNotifications,
  emptyNotificationsHint,
  notificationViewerOf,
  type NotificationItem,
  type NotificationViewer,
} from "@/lib/notifications/notifications";
import { loadNotificationsInput, markNotificationsSeen } from "@/lib/notifications/queries";
import { createClient } from "@/lib/supabase";

// „Powiadomienia” (#129, GLOSSARY „Powiadomienie”): powiadomienia o zapisach konta, najnowsze na górze,
// każde prowadzi do zapisu, którego dotyczy. Strona jest wspólna dla każdej roli (dostęp — middleware, mapa
// tras w @/lib/auth/roles). Nowe = nowsze od poprzedniego otwarcia strony; otwarcie ustawia tę datę na teraz,
// więc dzwonek w górnym pasku (liczony po tym frontmatterze) pokazuje już zero.
const { profile, instructorStanding } = Astro.locals;
const viewer: NotificationViewer | null =
  profile && isUserRole(profile.role) ? notificationViewerOf(profile.role, instructorStanding) : null;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let items: NotificationItem[] = [];
let loadFailed = false;

if (supabase && profile && viewer) {
  try {
    items = composeNotifications(await loadNotificationsInput(supabase, profile.id, viewer));
  } catch (error) {
    loadFailed = true;
    logError("page:powiadomienia", error);
  }
  if (!loadFailed) {
    try {
      await markNotificationsSeen(supabase);
    } catch (error) {
      // Lista jest już wczytana — nieudane oznaczenie zostawia tylko licznik na dzwonku.
      logError("page:powiadomienia", error);
    }
  }
} else {
  loadFailed = true;
}
---

<Layout title="Powiadomienia">
  <Topbar />
  <main class="container-narrow page">
    <h1>Powiadomienia</h1>
    <p class="page-lead">Najnowsze na górze. Każde prowadzi do zapisu, którego dotyczy.</p>

    {
      loadFailed ? (
        <FailureState>
          <p>Nie udało się wczytać powiadomień.</p>
          <p>Odśwież stronę za chwilę.</p>
        </FailureState>
      ) : items.length === 0 ? (
        <div class="section">
          <Card>
            <EmptyState>
              <p>Nie masz jeszcze powiadomień.</p>
              {viewer && <p>{emptyNotificationsHint(viewer)}</p>}
            </EmptyState>
          </Card>
        </div>
      ) : (
        <div class="section">
          <Card padding={8}>
            <ul class="items" aria-label="Powiadomienia">
              {items.map((item) => (
                <li class:list={{ unread: item.unread }}>
                  <a href={item.href}>
                    <span class="item__body">
                      <span class="item__head">
                        <span class="item__title">{item.title}</span>
                        {item.unread && <Tag variant="primary">nowe</Tag>}
                      </span>
                      <span class="item__subject">{item.subject}</span>
                      <span class="item__slot">
                        {formatLongDate(item.day)}, <span class="mono-nums">{formatClockHour(item.hour)}</span>
                        {item.instructorName && <> · {item.instructorName}</>}
                      </span>
                      {item.reason && <span class="item__reason">Powód: {item.reason}</span>}
                      <time class="item__at mono-nums" datetime={item.at.toISOString()}>
                        {formatDateTime(item.at)}
                      </time>
                    </span>
                    <ChevronRight className="size-4 item__go" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </Card>
        </div>
      )
    }
  </main>
</Layout>

<style>
  .page {
    padding-block: 24px 56px;
  }
  h1 {
    font-size: 32px;
  }
  .page-lead {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 62ch;
  }
  .section {
    display: block;
    margin-top: 18px;
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .items > li + li {
    border-top: 1px solid var(--border);
  }
  .items a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border-radius: var(--r);
    color: inherit;
    text-decoration: none;
    transition: background 0.15s;
  }
  .items a:hover {
    background: var(--primary-soft);
  }
  .items a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
  }
  /* Nowe powiadomienie: pasek w kolorze marki przy lewej krawędzi. */
  .items li.unread a {
    box-shadow: inset 3px 0 0 var(--primary);
  }
  .item__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1;
  }
  .item__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
  }
  .item__title {
    font-weight: 600;
  }
  .item__subject,
  .item__slot {
    font-size: 14.5px;
    overflow-wrap: anywhere;
  }
  .item__slot,
  .item__at {
    color: var(--muted);
  }
  .item__reason {
    font-size: 14.5px;
    overflow-wrap: anywhere;
  }
  .item__at {
    font-size: 13px;
  }
  .items :global(.item__go) {
    flex: none;
    color: var(--faint);
  }
</style>
