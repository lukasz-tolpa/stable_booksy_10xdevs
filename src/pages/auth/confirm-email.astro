---
import Topbar from "@/components/Topbar.astro";
import Card from "@/components/ui/Card.astro";
import Layout from "@/layouts/Layout.astro";

// Strona jest poza przepływem rejestracji: potwierdzanie adresu e-mail jest wyłączone
// zarówno lokalnie (enable_confirmations w supabase/config.toml), jak i na zdalnym
// projekcie (mailer_autoconfirm), więc konto po rejestracji jest od razu zalogowane
// i trafia prosto do przestrzeni swojej roli. Zostawiamy ją gotową na wypadek, gdyby
// potwierdzanie zostało kiedyś włączone - wtedy wystarczy znów tu kierować.
const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Konto założone",
      description: "Twoje konto zostało utworzone. Możesz się zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      emoji: "📧",
      heading: "Sprawdź pocztę",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.",
      linkText: "Wróć do logowania",
    };
---

<Layout title={content.heading}>
  <Topbar />
  <div class="container-narrow authwrap">
    <Card class="w-full max-w-[420px]" padding={28}>
      <div class="confirm">
        <div class="emoji">{content.emoji}</div>
        <h1>{content.heading}</h1>
        <p class="lead">{content.description}</p>
        <a href="/auth/signin">{content.linkText}</a>
      </div>
    </Card>
  </div>
</Layout>

<style>
  .authwrap {
    display: flex;
    justify-content: center;
    padding-block: 36px 56px;
  }
  .confirm {
    text-align: center;
  }
  .emoji {
    font-size: 44px;
    line-height: 1;
    margin-bottom: 14px;
  }
  h1 {
    font-size: 26px;
    margin: 0 0 8px;
  }
  .lead {
    font-size: 14.5px;
    color: var(--muted);
    margin: 0 0 22px;
  }
  .confirm a {
    font-size: 14.5px;
    color: var(--primary);
    font-weight: 600;
  }
  .confirm a:hover {
    color: var(--primary-strong);
    text-decoration: underline;
  }
  .confirm a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
    border-radius: 6px;
  }
</style>
