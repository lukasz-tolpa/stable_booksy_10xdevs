# Nagłówki plików statycznych (Cloudflare Workers Static Assets).
# Stosowane tylko do plików z dist/client — strony renderowane przez worker dostają
# nagłówki bezpieczeństwa z src/lib/http/security-headers.ts (middleware).
# Test src/lib/http/static-headers.test.ts pilnuje, żeby obie listy się zgadzały.
# Uwaga: nagłówki z kilku pasujących reguł są sklejane, więc Cache-Control
# ustawia dokładnie jedna reguła na plik. Bez CSP i HSTS (spec #62).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# Zasoby budowane przez Astro mają hash w nazwie — nowa wersja to nowy adres.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pliki bez hasha w nazwie: 30 dni, bez immutable (po podmianie pliku przeglądarka
# w końcu dociągnie nowy). Nowy plik w public/ dopisz tutaj.
/jeden-dzien/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

/favicon.png
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/icon-512.png
  Cache-Control: public, max-age=2592000

/og-image.png
  Cache-Control: public, max-age=2592000
